# Green Park Eco Hotel — environment variables
# Copy this file to `.env` (gitignored) and fill in real values for local dev.
# In production, set these via the Railway dashboard's Variables tab.
#
# Every variable read by the app via `process.env.*` is declared in
# `src/lib/env.ts` and validated at boot via `scripts/check-env.ts`.
# Keep this file in sync with that schema.

# ─── Database ─────────────────────────────────────────────────────
# Local dev: postgres://<user>:<password>@localhost:5432/indefine_kitchen
# Railway:   ${{ Postgres.DATABASE_URL }}   (uses the curly-brace reference)
DATABASE_URL=postgres://<user>:<password>@<host>:5432/<db>

# ─── Auth ─────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32   (must be at least 32 chars)
AUTH_SECRET=<generate-via-openssl-rand-base64-32>
# Legacy alias read as a fallback by auth.ts; usually leave blank.
NEXTAUTH_SECRET=
# Public origin used by NextAuth callback URLs.
#   local dev: http://localhost:3000
#   prod:      https://kitchen.greenparkecohotel.in
NEXTAUTH_URL=http://localhost:3000

# ─── App ──────────────────────────────────────────────────────────
NODE_ENV=development
# Railway injects PORT at runtime — leave unset locally so Next picks 3000.
# PORT=8080
# HOSTNAME=0.0.0.0
APP_TZ=Asia/Kolkata

# ─── Deployment ───────────────────────────────────────────────────
# Set to "true" on the FIRST Railway deploy only — the docker-entrypoint
# runs `tsx prisma/seed.ts` to create the seven default users
# (admin@, manager@, sales@, store@, chef@, delivery@, accounts@,
#  housekeeping@, maintenance@) with password "changeme123".
# Leave UNSET on subsequent deploys.
SEED_DB=

# ─── Org constants ────────────────────────────────────────────────
# Karnataka = 29. Used by GST math (CGST+SGST when buyer state matches; IGST otherwise).
INDEFINE_STATE_CODE=29
# Optional org metadata overrides (defaults live in src/lib/org.ts).
INDEFINE_GSTIN=
INDEFINE_ADDRESS=
INDEFINE_BANK_DETAILS=
INDEFINE_LOGO_URL=
INDEFINE_COMPANY_NAME=

# ─── File storage (Phase 1+) ──────────────────────────────────────
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
# Local-dev upload root used by src/lib/storage.ts when no S3 bucket is
# set. Defaults to ./public/uploads (gitignored) when unset.
UPLOAD_ROOT=

# ─── SMS / OTP (Phase 1) ──────────────────────────────────────────
# "console" prints OTPs to stdout in dev; switch to "msg91" in prod.
SMS_PROVIDER=console
MSG91_AUTHKEY=

# ─── Email (Phase 2) ──────────────────────────────────────────────
# Auto-sends proformas + tax invoices. If the trio below isn't fully set,
# src/lib/email.ts falls back to console mode and just logs the message.
# Defaults are tuned for Outlook / Office 365 (STARTTLS on 587).
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=ops@greenparkecohotel.in
# Office 365 / Outlook app password (Account → Security → App passwords).
SMTP_PASS=
# Optional friendly "From" header. Defaults to "Green Park Eco Hotel <SMTP_USER>".
EMAIL_FROM="Green Park Eco Hotel <ops@greenparkecohotel.in>"
# Set to "1" in dev to also dump the email body when running in console mode.
EMAIL_LOG_BODY=

# ─── E-invoicing GSP (Phase 3) ────────────────────────────────────
# "nic-sandbox" for staging, "cleartax" for prod.
EINVOICE_PROVIDER=nic-sandbox
CLEARTAX_API_KEY=
CLEARTAX_GSP_GSTIN=

# ─── FCM push (Phase 5) ──────────────────────────────────────────
# base64-encoded service-account JSON
FCM_SERVICE_ACCOUNT_JSON=

# ─── AI integrations (optional) ──────────────────────────────────
# Set AI_ENABLED=true to turn on Claude-backed features.
AI_ENABLED=
ANTHROPIC_API_KEY=
AI_MODEL_DEFAULT=
AI_MODEL_FAST=
