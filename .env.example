# Indefine Kitchen — environment variables
# Copy this file to `.env` (gitignored) and fill in real values for local dev.
# In production, set these via the Railway dashboard's environment editor.
#
# Every variable read by the app via `process.env.*` must be listed here.
# See docs/SECURITY.md §1.

# ─── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgres://<user>:<password>@<host>:5432/<db>

# ─── Auth ─────────────────────────────────────────────────────────
# Generate via: openssl rand -base64 32  (min 32 chars)
AUTH_SECRET=<generate-via-openssl-rand-base64-32>
# Alias read as fallback by auth.ts; usually unset (AUTH_SECRET is the
# primary). Keep documented in case a tool sets only the legacy name.
NEXTAUTH_SECRET=
# Web origin used by NextAuth callback URLs. http://localhost:3000 for dev,
# https://kitchen.indefine.in for production.
NEXTAUTH_URL=http://localhost:3000

# ─── File storage (Phase 1+) ──────────────────────────────────────
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
# Local-dev upload root used by src/lib/storage.ts when no S3 bucket is set.
# Defaults to ./public/uploads (gitignored) when unset.
UPLOAD_ROOT=

# ─── SMS / OTP (Phase 1) ──────────────────────────────────────────
# "console" prints OTPs to stdout in dev; switch to "msg91" in prod.
SMS_PROVIDER=console
MSG91_AUTHKEY=

# ─── Email (Phase 2) ──────────────────────────────────────────────
# Used to auto-send proformas + tax invoices to customers. When the trio
# below isn't all set, src/lib/email.ts falls back to console mode and
# just logs the message instead of sending. Defaults are tuned for
# Outlook / Office 365 (STARTTLS on 587, TLSv1.2).
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=ops@indefine.in
# Office 365 / Outlook app password (Account → Security → App passwords)
SMTP_PASS=
# Optional friendly "From" header. Defaults to "Indefine Kitchen <SMTP_USER>".
EMAIL_FROM="Indefine Kitchen <ops@indefine.in>"
# Set to "1" in dev to also dump the email body when running in console mode.
EMAIL_LOG_BODY=

# ─── E-invoicing GSP (Phase 3) ────────────────────────────────────
# "nic-sandbox" for staging, "cleartax" for prod.
EINVOICE_PROVIDER=nic-sandbox
CLEARTAX_API_KEY=
CLEARTAX_GSP_GSTIN=

# ─── FCM push (Phase 5) ──────────────────────────────────────────
# base64-encoded service-account JSON
FCM_SERVICE_ACCOUNT_JSON=

# ─── Org constants ───────────────────────────────────────────────
APP_TZ=Asia/Kolkata
# Karnataka = 29. Used by GST math (CGST+SGST when buyer state matches; IGST otherwise).
INDEFINE_STATE_CODE=29
# Optional org metadata overrides (see src/lib/org.ts for defaults)
INDEFINE_GSTIN=
INDEFINE_ADDRESS=
INDEFINE_BANK_DETAILS=
INDEFINE_LOGO_URL=
INDEFINE_COMPANY_NAME=

NODE_ENV=development
