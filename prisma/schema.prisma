// =====================================================================

model OrderCodeSequence {
  year Int @id
  next Int @default(1)
}

model QuoteNumberSequence {
  year Int @id
  next Int @default(1)
}

model CustomerInvoiceNumberSequence {
  year Int @id
  next Int @default(1)
}

model RequisitionNumberSequence {
  year Int @id
  next Int @default(1)
}

model VendorCodeSequence {
  year Int @id
  next Int @default(1)
