model VendorPONumberSequence {
  year Int @id
  next Int @default(1)
}

model GRNNumberSequence {
  year Int @id
  next Int @default(1)
}

model VendorBillNumberSequence {
  year Int @id
  next Int @default(1)
}

model ProductionJobNumberSequence {
  year Int @id
  next Int @default(1)
}

model DeliveryNumberSequence {
  year Int @id
  next Int @default(1)
}

model PettyCashVoucherNumberSequence {
  year Int @id
  next Int @default(1)
}

model SalaryRunNumberSequence {
  year Int @id
  next Int @default(1)
}

model ChefRequisitionNumberSequence {
  year Int @id
  next Int @default(1)
}

model BanquetRequisitionNumberSequence {
  year Int @id
  next Int @default(1)
}

// =====================================================================
// TASK ASSIGNMENT
// =====================================================================
// Admin/manager-assigned ad-hoc tasks. Distinct from operational workflow
// (orders, requisitions) — these are line-management tasks ("recount
// freezer A", "call client X", "fix POS printer"). Assignee submits with
// mandatory remarks; assigner approves or rejects.

enum TaskStatus {
  ASSIGNED // freshly assigned, not yet submitted
  SUBMITTED // assignee has marked done and provided remarks
  COMPLETED // assigner has approved the submission
  REJECTED // assigner rejected; assignee can resubmit
  CANCELLED // assigner cancelled before completion
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
}

// Optional library of preset task titles the admin can pick from
// (instead of typing every time). Editable in admin UI; soft-deleted.
model TaskTemplate {
  id          String   @id @default(cuid())
  title       String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks Task[] @relation("TaskFromTemplate")

  @@index([active])
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  priority    TaskPriority @default(NORMAL)
  status      TaskStatus   @default(ASSIGNED)

  assignedToId String
  assignedTo   User   @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  assignedById String
  assignedBy   User   @relation("TaskAssignedBy", fields: [assignedById], references: [id])

  targetDate DateTime // when assigner wants it done by (UTC, displayed IST)
  assignedAt DateTime @default(now())

  // Submission (filled when assignee submits)
  submittedAt       DateTime?
  completionRemarks String? // MANDATORY at submit; nullable in DB to allow re-submit cycles
  completedAt       DateTime? // event date entered by assignee (when they actually did the work)

  // Review (filled when assigner approves or rejects)
  reviewedAt      DateTime?
  reviewedById    String?
  reviewedBy      User?     @relation("TaskReviewedBy", fields: [reviewedById], references: [id])
  rejectionReason String?

  // Optional preset link
  templateId String?
  template   TaskTemplate? @relation("TaskFromTemplate", fields: [templateId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assignedToId, status])
  @@index([assignedById])
  @@index([status, targetDate])
  @@index([targetDate])
}

// =====================================================================
// HOUSEKEEPING (hotel side — distinct from kitchen inventory)
// =====================================================================
// Separate stockroom for guest-facing supplies (soap, towel, shampoo,
// bedsheets …). The maintenance / purchasing team gives stock to the
// housekeeping department; the housekeeping manager records receipts,
// then logs every issue-to-room with the housekeeping staff member who
// took the items. Current on-hand is denormalised on HousekeepingItem.

enum RoomType {
  STANDARD
  DELUXE
  SUITE
  COMMON_AREA // lobby, corridor, gym etc. — supplies that aren't room-specific
  OTHER
}

model Room {
  id        String   @id @default(cuid())
  number    String   @unique // "101", "L-12", "POOL-1"
  name      String? // optional friendly name ("Garden Suite")
  type      RoomType @default(STANDARD)
  floor     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  housekeepingIssues    HousekeepingIssue[]
  maintenanceActivities MaintenanceActivity[]

  @@index([active])
}

model HousekeepingStaff {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  housekeepingIssues HousekeepingIssue[]

  @@index([active])
}

// Catalog of housekeeping supplies. Stock kept here is hotel-side only —
// totally separate from kitchen Ingredient stock. `currentStock` is
// denormalised (sum of receipts − sum of issues, maintained inside
// transactions when receipts/issues are recorded).
model HousekeepingItem {
  id            String   @id @default(cuid())
  name          String
  sku           String? // optional internal SKU
  unit          String   @default("piece") // "piece", "set", "ml", "kg", "pair"
  currentStock  Decimal  @default(0) @db.Decimal(14, 3) // clean / available stock
  minStock      Decimal? @db.Decimal(14, 3) // optional low-stock threshold
  // Reusable items (towels, linens, robes) loop: issuing moves units from
  // currentStock into inCirculation; returning after a wash moves them back.
  // Consumables (soap, tissue) stay reusable=false / inCirculation=0.
  reusable      Boolean  @default(false)
  inCirculation Decimal  @default(0) @db.Decimal(14, 3) // issued, not yet returned
  notes         String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  receiptLines HousekeepingReceiptLine[]
  issueLines   HousekeepingIssueLine[]

  @@unique([name])
  @@index([active])
}

// Stock IN — maintenance team handing over supplies. The housekeeping
// manager (or admin) records this. `sourceNote` captures who supplied
// it (e.g. "Maintenance — Mr Kumar, GRN-9183").
model HousekeepingReceipt {
  id            String   @id @default(cuid())
  receivedAt    DateTime
  recordedById  String
  recordedBy    User     @relation("HousekeepingReceiptRecordedBy", fields: [recordedById], references: [id])
  sourceNote    String? // free-text — "from kitchen store", "vendor delivery"
  sourceContact String? // name of the maintenance person who handed over
  createdAt     DateTime @default(now())

  lines HousekeepingReceiptLine[]

  @@index([receivedAt])
}

model HousekeepingReceiptLine {
  id          String              @id @default(cuid())
  receiptId   String
  receipt     HousekeepingReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  itemId      String
  item        HousekeepingItem    @relation(fields: [itemId], references: [id])
  quantity    Decimal             @db.Decimal(14, 3)
  // Optional cost tracking — useful for the admin consumption-value report.
  costPerUnit Decimal?            @db.Decimal(12, 2)

  @@index([receiptId])
  @@index([itemId])
}

// Stock OUT — housekeeping staff took items to a room (or common area).
// One issue = one trip by one staff member to one room. Lines are the
// items they carried.
model HousekeepingIssue {
  id           String            @id @default(cuid())
  issuedAt     DateTime
  recordedById String
  recordedBy   User              @relation("HousekeepingIssueRecordedBy", fields: [recordedById], references: [id])
  staffId      String
  staff        HousekeepingStaff @relation(fields: [staffId], references: [id])
  roomId       String
  room         Room              @relation(fields: [roomId], references: [id])
  // Free-text e.g. "guest checkout cleaning", "fresh linen swap"
  purpose      String?
  notes        String?
  createdAt    DateTime          @default(now())

  lines HousekeepingIssueLine[]

  @@index([issuedAt])
  @@index([roomId])
  @@index([staffId])
}

model HousekeepingIssueLine {
  id       String            @id @default(cuid())
  issueId  String
  issue    HousekeepingIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  itemId   String
  item     HousekeepingItem  @relation(fields: [itemId], references: [id])
  quantity Decimal           @db.Decimal(14, 3)

  @@index([issueId])
  @@index([itemId])
}

// =====================================================================
// MAINTENANCE (electrical / mechanical work + spares inventory)
// =====================================================================
// Mirrors housekeeping in shape but with a category dimension
// (ELECTRICAL / MECHANICAL / GENERAL) and a richer "Activity" record at
// the room (issueReported + workDone) instead of a plain issue. Rooms
// are reused from the housekeeping Room model.

enum MaintenanceCategory {
  ELECTRICAL
  MECHANICAL
  GENERAL // catch-all (plumbing tools, consumables that span both)
}

enum MaintenanceActivityStatus {
  PENDING // logged but the work hasn't been started yet
  IN_PROGRESS // staff is on it
  COMPLETED // resolved
  CANCELLED // false alarm / not needed
}

model MaintenanceStaff {
  id        String              @id @default(cuid())
  name      String
  phone     String?
  category  MaintenanceCategory @default(GENERAL) // primary skill
  notes     String?
  active    Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  activities MaintenanceActivity[]

  @@index([active])
  @@index([category])
}

model MaintenanceItem {
  id           String              @id @default(cuid())
  name         String
  sku          String?
  unit         String              @default("piece") // "piece", "m", "kg", "set", "L"
  category     MaintenanceCategory @default(GENERAL)
  currentStock Decimal             @default(0) @db.Decimal(14, 3)
  minStock     Decimal?            @db.Decimal(14, 3)
  notes        String?
  active       Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  receiptLines  MaintenanceReceiptLine[]
  activityLines MaintenanceActivityLine[]

  @@unique([name])
  @@index([active])
  @@index([category])
}

// Stock IN — purchased / handed-over to maintenance.
model MaintenanceReceipt {
  id            String   @id @default(cuid())
  receivedAt    DateTime
  recordedById  String
  recordedBy    User     @relation("MaintenanceReceiptRecordedBy", fields: [recordedById], references: [id])
  sourceNote    String?
  sourceContact String?
  createdAt     DateTime @default(now())

  lines MaintenanceReceiptLine[]

  @@index([receivedAt])
}

model MaintenanceReceiptLine {
  id          String             @id @default(cuid())
  receiptId   String
  receipt     MaintenanceReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  itemId      String
  item        MaintenanceItem    @relation(fields: [itemId], references: [id])
  quantity    Decimal            @db.Decimal(14, 3)
  costPerUnit Decimal?           @db.Decimal(12, 2)

  @@index([receiptId])
  @@index([itemId])
}

// Activity — one work visit at a room. The "issueReported" captures what
// the housekeeping / front-desk reported; "workDone" is what was actually
// fixed. Items consumed are recorded on `lines` and decrement stock.
model MaintenanceActivity {
  id            String                    @id @default(cuid())
  performedAt   DateTime
  recordedById  String
  recordedBy    User                      @relation("MaintenanceActivityRecordedBy", fields: [recordedById], references: [id])
  staffId       String
  staff         MaintenanceStaff          @relation(fields: [staffId], references: [id])
  roomId        String
  room          Room                      @relation(fields: [roomId], references: [id])
  category      MaintenanceCategory
  status        MaintenanceActivityStatus @default(COMPLETED)
  issueReported String // "AC not cooling", "tap dripping"
  workDone      String? // "replaced capacitor", "tightened washer"
  notes         String?
  createdAt     DateTime                  @default(now())

  lines MaintenanceActivityLine[]

  @@index([performedAt])
  @@index([roomId])
  @@index([staffId])
  @@index([status])
  @@index([category])
}

model MaintenanceActivityLine {
  id         String              @id @default(cuid())
  activityId String
  activity   MaintenanceActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  itemId     String
  item       MaintenanceItem     @relation(fields: [itemId], references: [id])
  quantity   Decimal             @db.Decimal(14, 3)

  @@index([activityId])
  @@index([itemId])
}

// =====================================================================
// BANQUET STORE (F&B service-side packaging — Phase 3)
// =====================================================================
// Mirrors HousekeepingItem in shape. Holds service-side disposables:
// paper cups, meal trays, tissue, foil, cake boxes, takeaway containers
// etc. The FnB Store Excel from the client seeds this catalog at ~44
// SKUs across packaging, condiments, and event materials.
//
// Approval flow (per the workflow doc matrix):
//   F&B raises requisition → Purchase (Store) raises PO →
//   Manager + Admin double-approve always.
// The current PO engine handles the threshold rule; per-category
// override comes in a later phase.

model BanquetItem {
  id           String   @id @default(cuid())
  name         String
  // GP item code — same counter as Ingredient.sku, see nextGPItemCode.
  sku          String?
  legacySku    String?
  // Free-text sub-grouping for the catalog: "Packaging", "Tissue",
  // "Tape", "Ketchup", "Cutlery", "Foil"… seeded from the FnB Excel.
  category     String?
  unit         String   @default("piece")
  currentStock Decimal  @default(0) @db.Decimal(14, 3)
  minStock     Decimal? @db.Decimal(14, 3)
  notes        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  receiptLines     BanquetReceiptLine[]
  issueLines       BanquetIssueLine[]
  returnLines      BanquetReturnLine[]
  requisitionLines BanquetRequisitionLine[]
  vendorPOLines    VendorPOLine[]           @relation("VendorPOLineToBanquetItem")

  @@unique([name])
  @@index([active])
  @@index([category])
}

// Stock IN — bought from vendor (or transferred in from another store).
model BanquetReceipt {
  id            String   @id @default(cuid())
  receivedAt    DateTime
  recordedById  String
  recordedBy    User     @relation("BanquetReceiptRecordedBy", fields: [recordedById], references: [id])
  sourceNote    String?
  sourceContact String?
  createdAt     DateTime @default(now())

  lines BanquetReceiptLine[]

  @@index([receivedAt])
}

model BanquetReceiptLine {
  id          String         @id @default(cuid())
  receiptId   String
  receipt     BanquetReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  itemId      String
  item        BanquetItem    @relation(fields: [itemId], references: [id])
  quantity    Decimal        @db.Decimal(14, 3)
  costPerUnit Decimal?       @db.Decimal(12, 2)

  @@index([receiptId])
  @@index([itemId])
}

// Stock OUT — issued from the banquet store to a service area / event.
// Unlike HK (issued to a room), banquet items typically go to "today's
// catering ODC" or "Room service prep" — captured as a free-text
// purpose plus optional Order link.
model BanquetIssue {
  id           String   @id @default(cuid())
  issuedAt     DateTime
  recordedById String
  recordedBy   User     @relation("BanquetIssueRecordedBy", fields: [recordedById], references: [id])
  purpose      String // e.g. "Wipro lunch ODC", "Floor 3 cleaning"
  // Optional link to the catering order this stock served.
  orderId      String?
  order        Order?   @relation("BanquetIssueOrder", fields: [orderId], references: [id], onDelete: SetNull)
  notes        String?
  createdAt    DateTime @default(now())

  lines BanquetIssueLine[]

  @@index([issuedAt])
  @@index([orderId])
}

model BanquetIssueLine {
  id       String       @id @default(cuid())
  issueId  String
  issue    BanquetIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  itemId   String
  item     BanquetItem  @relation(fields: [itemId], references: [id])
  quantity Decimal      @db.Decimal(14, 3)

  @@index([issueId])
  @@index([itemId])
}

// Cutlery/arrangements coming BACK from an event. Paired with the
// order-linked BanquetIssue rows this gives a per-client ledger:
// issued − returned = still out (chargeable to the client or to the
// person who handled the delivery).
model BanquetReturn {
  id           String   @id @default(cuid())
  returnedAt   DateTime
  recordedById String
  recordedBy   User     @relation("BanquetReturnRecordedBy", fields: [recordedById], references: [id])
  orderId      String
  order        Order    @relation("BanquetReturnOrder", fields: [orderId], references: [id], onDelete: Cascade)
  notes        String?
  createdAt    DateTime @default(now())

  lines BanquetReturnLine[]

  @@index([returnedAt])
  @@index([orderId])
}

model BanquetReturnLine {
  id       String        @id @default(cuid())
  returnId String
  return   BanquetReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  itemId   String
  item     BanquetItem   @relation(fields: [itemId], references: [id])
  quantity Decimal       @db.Decimal(14, 3)

  @@index([returnId])
  @@index([itemId])
}

// F&B service asks the banquet store for cutlery/disposables; the store
// issues what's in stock (full or partial) and raises a PO for the rest.
model BanquetRequisition {
  id                String                   @id @default(cuid())
  requisitionNo     String                   @unique // BRQ-26-27-0001
  orderId           String?
  order             Order?                   @relation("BanquetRequisitionOrder", fields: [orderId], references: [id], onDelete: SetNull)
  status            BanquetRequisitionStatus @default(SUBMITTED)
  notes             String?
  createdById       String
  createdBy         User                     @relation("BanquetRequisitionCreatedBy", fields: [createdById], references: [id])
  submittedAt       DateTime                 @default(now())
  lastFulfilledById String?
  lastFulfilledBy   User?                    @relation("BanquetRequisitionFulfilledBy", fields: [lastFulfilledById], references: [id])
  closedAt          DateTime?
  // F&B/store re-checked these lines against the order's latest revision.
  revisionAckAt     DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  lines BanquetRequisitionLine[]

  @@index([status])
  @@index([orderId])
  @@index([createdById])
}

// Serving staff allocated to an event order by the F&B team once the
// kitchen posts it ready. Staff are named free-text (captains/waiters are
// usually not app users); duty is an optional label like "Buffet counter".
model OrderStaffAllocation {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  staffName     String
  duty          String?
  allocatedById String
  allocatedBy   User     @relation("StaffAllocationBy", fields: [allocatedById], references: [id])
  createdAt     DateTime @default(now())

  @@index([orderId])
}

// Leftovers returned from a counter-sale / ODC event (cake, juice, chips…)
// and where they went (next-day breakfast / charity / discarded). A per-
// order returns log for traceability; no stock posting.
model OrderLeftoverReturn {
  id           String              @id @default(cuid())
  orderId      String
  order        Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemName     String
  quantity     Decimal             @db.Decimal(14, 3)
  unit         String
  disposition  LeftoverDisposition
  note         String?
  recordedById String
  recordedBy   User                @relation("LeftoverReturnBy", fields: [recordedById], references: [id])
  createdAt    DateTime            @default(now())

  @@index([orderId])
}

model BanquetRequisitionLine {
  id             String                       @id @default(cuid())
  requisitionId  String
  requisition    BanquetRequisition           @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  itemId         String
  item           BanquetItem                  @relation(fields: [itemId], references: [id])
  requestedQty   Decimal                      @db.Decimal(14, 3)
  issuedQty      Decimal                      @default(0) @db.Decimal(14, 3)
  status         BanquetRequisitionLineStatus @default(PENDING)
  notes          String?
  // The PO line buying this line's shortfall (set by 'Raise PO'); GRN
  // acceptance flips the line back to PENDING so the store issues it.
  vendorPOLineId String?
  vendorPOLine   VendorPOLine?                @relation(fields: [vendorPOLineId], references: [id])

  @@index([requisitionId])
  @@index([itemId])
  @@index([status])
}

// =====================================================================
// NOTIFICATIONS (Phase 5)
// =====================================================================
// Lightweight per-user bell-icon notifications. Polled on dashboard
// load + on the bell-dropdown open. No realtime / websocket layer —
// kept deliberately simple. dedupeKey lets event hooks avoid duplicate
// rows when the same transition fires twice.

enum NotificationKind {
  PO_AWAITING_ADMIN
  PO_APPROVED
  VENDOR_BILL_PAID
  CUSTOMER_INVOICE_PAID
  TASK_ASSIGNED
  TASK_SUBMITTED
  CHEF_REQUISITION_FULFILLED
  FEEDBACK_RECEIVED
  VENDOR_PAYMENT_REMINDER
  // Order confirmed (chef approved feasibility / manager OK'd changes).
  // Fans out to the kitchen (raise requisition) AND the delivery team
  // (prepare cutlery + event arrangements).
  ORDER_APPROVED
  GENERIC
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation("NotificationToUser", fields: [userId], references: [id], onDelete: Cascade)
  kind      NotificationKind
  title     String
  body      String?
  link      String?
  dedupeKey String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
  @@index([createdAt])
}

// One row per mid-flight order revision (pax / date / meal / value / line
// changes). The chef reads this on the order page — the audit log only
// stores a hash, which nobody can read back.
model OrderRevision {
  id                  String   @id @default(cuid())
  orderId             String
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  revisedById         String
  revisedBy           User     @relation("OrderRevisionRevisedBy", fields: [revisedById], references: [id])
  note                String?
  beforeHeadcount     Int
  afterHeadcount      Int
  beforeContractValue Decimal  @db.Decimal(14, 2)
  afterContractValue  Decimal  @db.Decimal(14, 2)
  beforeEventDate     DateTime
  afterEventDate      DateTime
  beforeMealType      MealType
  afterMealType       MealType
  // [{kind:"added"|"removed"|"portions", dish, from?, to?}]
  lineChanges         Json?
  createdAt           DateTime @default(now())

  @@index([orderId, createdAt])
}

// Manager-defined recurring order template: pick it, tweak the date, order.
// Create/edit/remove is ADMIN/MANAGER only (client item #2).
model OrderTemplate {
  id              String              @id @default(cuid())
  name            String
  customerId      String
  customer        Customer            @relation(fields: [customerId], references: [id])
  channel         OrderChannel
  mealType        MealType
  headcount       Int
  packageTotal    Decimal?            @db.Decimal(14, 2)
  deliveryAddress String?
  notes           String?
  active          Boolean             @default(true)
  createdById     String
  createdBy       User                @relation("OrderTemplateCreatedBy", fields: [createdById], references: [id])
  items           OrderTemplateItem[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([active])
}

model OrderTemplateItem {
  id         String        @id @default(cuid())
  templateId String
  template   OrderTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  dishId     String
  dish       Dish          @relation(fields: [dishId], references: [id])
  portions   Decimal       @db.Decimal(12, 2)
  sortOrder  Int

  @@index([templateId])
}

// Money paid to a supplier BEFORE their bill exists (client item #12).
// Recorded against the vendor (optionally earmarked to a PO); later applied
// to a bill, which posts a real VendorBillPayment for the amount.
model VendorAdvance {
  id              String        @id @default(cuid())
  vendorId        String
  vendor          Vendor        @relation(fields: [vendorId], references: [id])
  poId            String?
  po              VendorPO?     @relation(fields: [poId], references: [id])
  amount          Decimal       @db.Decimal(14, 2)
  method          PaymentMethod
  reference       String?
  notes           String?
  paidAt          DateTime
  recordedById    String
  recordedBy      User          @relation("VendorAdvanceRecordedBy", fields: [recordedById], references: [id])
  appliedToBillId String?
  appliedToBill   VendorBill?   @relation(fields: [appliedToBillId], references: [id])
  appliedAt       DateTime?
  createdAt       DateTime      @default(now())

  @@index([vendorId, appliedToBillId])
}

// =====================================================================
// MANPOWER (hired casual labour)
// =====================================================================

// The chef / F&B team hire casual labour in for a job — "6 people, 2 days,
// about ₹500 a head a day, for the Reddy wedding". The manager approves
// (possibly editing the count or the rate down first), the job gets done,
// accounts settle what the labour actually invoiced, and the money goes out.
//
// NOT OrderStaffAllocation: that names OUR OWN serving crew on an order and
// carries no money, no approval and no payment. This one is outside hire
// with a rupee figure attached, so it lives in its own table.
//
// orderId is nullable on purpose — a request can be raised standalone from
// the home screen as well as from inside an order.
enum ManpowerRequestStatus {
  REQUESTED
  APPROVED
  COMPLETED // the job was done; only now can money move
  PAID
  REJECTED // terminal exit
  CANCELLED // terminal exit
}

model ManpowerRequest {
  id      String  @id @default(cuid())
  orderId String?
  order   Order?  @relation("ManpowerRequestOrder", fields: [orderId], references: [id])

  status          ManpowerRequestStatus @default(REQUESTED)
  workDescription String
  notes           String?

  // What was ASKED FOR. Never overwritten — the monthly report has to be
  // able to say "asked for 6 at ₹500, approved 4 at ₹450".
  requestedPeople Int
  requestedDays   Int
  requestedRate   Decimal @db.Decimal(12, 2) // per person, per day

  requestedById String
  requestedBy   User   @relation("ManpowerRequestedBy", fields: [requestedById], references: [id])

  // What was APPROVED. Stamped on every approval — equal to the requested
  // figures when the manager changed nothing, so the estimate always reads
  // off one place without a "did they edit it?" branch.
  approvedPeople Int?
  approvedDays   Int?
  approvedRate   Decimal?  @db.Decimal(12, 2)
  approvedById   String?
  approvedBy     User?     @relation("ManpowerApprovedBy", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  approvalNote   String?

  rejectedById    String?
  rejectedBy      User?     @relation("ManpowerRejectedBy", fields: [rejectedById], references: [id])
  rejectedAt      DateTime?
  rejectionReason String?

  // The job was done. The payment gate keys off this, not off the UI.
  completedById String?
  completedBy   User?     @relation("ManpowerCompletedBy", fields: [completedById], references: [id])
  completedAt   DateTime?

  // What accounts actually settled on once the labour invoiced. Null until
  // then; the estimate above is what everyone works to in the meantime.
  actualCost  Decimal?  @db.Decimal(14, 2)
  settledById String?
  settledBy   User?     @relation("ManpowerSettledBy", fields: [settledById], references: [id])
  settledAt   DateTime?

  paidById         String?
  paidBy           User?          @relation("ManpowerPaidBy", fields: [paidById], references: [id])
  paidAt           DateTime?
  paymentMethod    PaymentMethod?
  paymentReference String?

  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([orderId])
  @@index([createdAt])
}
