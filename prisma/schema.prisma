// Indefine Kitchen — Prisma schema
// All money uses Decimal; timestamps are UTC in DB and rendered in IST at the edge.
// Lifted from SAB India Tracker (installation_industry_tracker-main), with vocabulary
// remapped for catering (Client → Customer, Material → Ingredient, Project → Order,
// MaterialIndent → PurchaseRequisition) and SAB-specific entities removed
// (AMC, ServiceIssue, MaterialTransfer, MaterialVerification, ProjectStage, ProjectMilestone).
// New catering-specific entities added: Dish, Recipe, RecipeIngredient, RecipeSubRecipe,
// OrderItem, ProductionJob, ProductionJobItem, Delivery, DeliveryAttempt, PettyCash*,
// Salary*, EInvoiceLog, Settings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================================
// ENUMS
// =====================================================================

enum Role {
  ADMIN
  MANAGER
  KITCHEN_HEAD
  STORE_KEEPER
  SALES
  DELIVERY
  ACCOUNTS
  HOUSEKEEPING_MANAGER
  MAINTENANCE_MANAGER
  FNB_SERVICE
}

enum EmploymentType {
  HOURLY
  SALARIED
}

// ---------- Quote ----------

enum QuoteStatus {
  DRAFT
  SENT
  CHANGES_REQUESTED
  REVISED
  NEGOTIATING
  ACCEPTED
  CONVERTED
  LOST
  EXPIRED
}

enum QuoteEventKind {
  SENT
  CUSTOMER_VIEWED
  CHANGES_REQUESTED
  REVISION_ISSUED
  NEGOTIATION
  ACCEPTED
  REJECTED
  NOTE
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  HIGH_TEA
  SNACKS
  CUSTOM
}

// How the order was taken — different channels have different UI, line
// rendering, approval rules, and downstream flow. Workflow doc Phase 4:
//   BANQUET       — corporate catering (the original flow; default)
//   ODC           — outdoor catering / banquet onsite. Items as
//                   sub-heads, total package price only.
//   PACKET        — packed lunch / take-away batches. Same rule as ODC.
//   ROOM_SERVICE  — hotel room service. Requires roomNumber.
//   ALACARTE      — in-house dining table service. Requires tableNumber.
//   MANAGEMENT    — internal staff meals, no invoicing required.
enum OrderChannel {
  BANQUET
  BUFFET
  ODC
  PACKET
  COUNTER_SALE
  ROOM_SERVICE
  ALACARTE
  MANAGEMENT
}

// Where returned counter-sale / ODC leftovers went. Traceability only —
// this is a returns log, not a stock movement (ad-hoc food items).
enum LeftoverDisposition {
  REUSE_BREAKFAST
  CHARITY
  DISCARDED
}

// How a purchase order is being procured. LOCAL + ONLINE always need both
// Manager AND Admin sign-off (regardless of value); STANDARD uses the value
// tier (Manager < ₹5k, Admin ≥ ₹5k).
enum ProcurementType {
  STANDARD
  LOCAL
  ONLINE
}

// ---------- Order ----------

enum OrderStatus {
  DRAFT
  // Workflow v3 (CRM-style): admin sees every new order before the
  // kitchen does, even self-created ones — so commercial guardrails are
  // applied uniformly.
  PENDING_ADMIN_APPROVAL // sales/manager/admin submitted; admin must approve
  REJECTED_BY_ADMIN // admin declined to take the order
  // Chef-first workflow (v2 stages kept). Admin approval flows the order
  // into PENDING_CHEF_APPROVAL automatically.
  PENDING_CHEF_APPROVAL // admin approved; chef to review feasibility
  CHANGES_PROPOSED_BY_CHEF // chef wants menu/timing changes; manager to OK
  CHEF_APPROVED // chef confirmed (after any manager-approved changes)
  CHEF_REQUISITION_PENDING // chef to raise the requisition for store
  ISSUING // chef raised requisition; store fulfilling line-by-line
  READY_FOR_PRODUCTION // all requisition lines issued
  IN_PREP // production job created and started
  READY // chef marked all dishes ready
  OUT_FOR_DELIVERY
  DELIVERED
  INVOICED
  PAID
  COMPLETED
  CANCELLED
  REJECTED_BY_MANAGER // manager rejected the chef's proposed changes
  // Legacy values from the v1 workflow. No new orders take these; kept so
  // the enum migration is non-destructive.
  PENDING_STORE_APPROVAL
  PENDING_MANAGER_APPROVAL
  REJECTED_BY_STORE
  APPROVED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
  OVERRIDDEN
  SUGGESTED_CHANGES // chef proposed alternates / additions
}

enum BudgetCategory {
  INGREDIENT
  LABOUR
  OVERHEAD
  OTHER
}

// ---------- Production ----------

enum ProductionJobStatus {
  QUEUED
  PREP
  COOKING
  READY
  CANCELLED
}

enum ProductionJobItemStatus {
  QUEUED
  IN_PROGRESS
  READY
  CANCELLED
}

// ---------- Chef Requisition (chef → store internal request) ----------

enum ChefRequisitionStatus {
  DRAFT // chef is composing
  SUBMITTED // sent to store
  PARTIALLY_ISSUED // some lines issued, others pending stock or PR
  FULLY_ISSUED // all lines satisfied
  CANCELLED
}

enum ChefRequisitionLineStatus {
  PENDING // not yet looked at
  ISSUED // store issued the full requested qty
  PARTIALLY_ISSUED // store issued some, awaiting more
  AWAITING_PROCUREMENT // store created a PR for the shortfall
  CANCELLED
}

// F&B service raises a Banquet Requisition; the store keeper fulfils it
// line by line (issue full / partial / raise PO on shortfall), mirroring
// the chef ingredient-requisition flow but against BanquetItem stock.
enum BanquetRequisitionStatus {
  SUBMITTED
  PARTIALLY_ISSUED
  FULLY_ISSUED
  CANCELLED
}

enum BanquetRequisitionLineStatus {
  PENDING
  ISSUED
  PARTIALLY_ISSUED
  AWAITING_PROCUREMENT
  CANCELLED
}

// ---------- Delivery ----------

enum DeliveryStatus {
  SCHEDULED
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  FAILED
  CANCELLED
}

// ---------- Inventory / Procurement ----------

enum PurchaseRequisitionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PARTIALLY_ISSUED
  ISSUED
  CANCELLED
}

enum VendorCategory {
  VEGETABLES
  MEAT
  DAIRY
  GROCERY
  SPICES
  BAKERY
  BEVERAGES
  PACKAGING
  GAS_FUEL
  SERVICES
  OTHER
}

enum VendorPaymentTerms {
  ADVANCE
  NET_7
  NET_15
  NET_30
  NET_45
  NET_60
}

enum VendorPOStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

enum GRNStatus {
  DRAFT
  ACCEPTED
  PARTIALLY_ACCEPTED
  REJECTED
}

enum VendorBillStatus {
  DRAFT
  PENDING_MATCH
  MATCHED
  DISCREPANCY
  APPROVED
  PAID
  OVERDUE
}

// ---------- Invoicing ----------

enum CustomerInvoiceKind {
  ORDER // standard catering order invoice
  ADVANCE // advance against an order
  ADHOC // miscellaneous invoice
  PROFORMA // non-binding, pre-delivery quote-with-numbers; no IRN
  CREDIT_NOTE
}

enum CustomerInvoiceStatus {
  DRAFT
  ISSUED
  PARTIAL
  PAID
  CANCELLED
}

enum EInvoiceStatus {
  NOT_REQUIRED // turnover below threshold or invoice kind exempt
  PENDING // queued for GSP submission
  GENERATED // IRN + signed QR received
  CANCELLED // cancelled within 24h via GSP
  FAILED // GSP call failed; see EInvoiceLog
}

// ---------- Payments ----------

enum PaymentMethod {
  CASH
  CHEQUE
  NEFT
  RTGS
  IMPS
  UPI
  BANK_TRANSFER
  CREDIT_NOTE
  WAIVER
  ADJUSTMENT
  OTHER
}

// ---------- Time entries ----------

enum TimeEntryStatus {
  OPEN
  SUBMITTED
  APPROVED
  REJECTED
}

// ---------- Petty cash / Salary ----------

enum PettyCashVoucherStatus {
  DRAFT
  POSTED
  REVERSED
}

enum SalaryRunStatus {
  DRAFT
  APPROVED
  POSTED
}

// ---------- Documents ----------

enum DocumentEntityType {
  ORDER
  QUOTE
  CUSTOMER_INVOICE
  VENDOR_PO
  VENDOR_BILL
  DELIVERY
  PETTY_CASH_VOUCHER
  PURCHASE_REQUISITION
}

enum DocumentKind {
  ORIGINAL
  SIGNED_COPY
  ATTACHMENT
  PHOTO
  PROOF_OF_DELIVERY
}

// =====================================================================
// IDENTITY
// =====================================================================

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  name           String
  passwordHash   String
  role           Role
  employmentType EmploymentType?
  phone          String?
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  rateCards EmployeeRateCard[]

  // Time / labour
  timeEntries     TimeEntry[] @relation("EmployeeEntries")
  approvedEntries TimeEntry[] @relation("ApproverEntries")

  // Operational ownership
  kitchenSupervisedOrders Order[]             @relation("KitchenSupervisor")
  productionJobsAssigned  ProductionJobItem[] @relation("ChefAssignedTo")
  deliveriesAssigned      Delivery[]          @relation("DriverAssignedTo")

  // Audit / mutations
  auditLogs                       AuditLog[]
  ingredientIssues                IngredientIssue[]
  ingredientReceiptsRecorded      IngredientReceipt[]      @relation("IngredientReceiptRecordedBy")
  ingredientReturnsRecorded       IngredientReturn[]       @relation("IngredientReturnRecordedBy")
  ingredientAdjustmentsRecorded   IngredientAdjustment[]   @relation("IngredientAdjustmentAdjustedBy")
  stockTransfersRecorded          StockTransfer[]          @relation("StockTransferRecordedBy")
  quotesCreated                   Quote[]                  @relation("QuoteCreatedBy")
  quoteEvents                     QuoteEvent[]             @relation("QuoteEventActor")
  customerInvoicesCreated         CustomerInvoice[]        @relation("CustomerInvoiceCreatedBy")
  customerInvoicesHeld            CustomerInvoice[]        @relation("CustomerInvoiceOnHoldBy")
  customerInvoicesApproved        CustomerInvoice[]        @relation("CustomerInvoiceApprovedBy")
  ordersCreated                   Order[]                  @relation("OrderCreatedBy")
  ordersStoreReviewed             Order[]                  @relation("OrderStoreReviewedBy")
  ordersManagerReviewed           Order[]                  @relation("OrderManagerReviewedBy")
  ordersChefReviewed              Order[]                  @relation("OrderChefReviewedBy")
  ordersManagerChangeReviewed     Order[]                  @relation("OrderManagerChangeReviewedBy")
  ordersAdminReviewed             Order[]                  @relation("OrderAdminReviewedBy")
  ordersEventPrepReady            Order[]                  @relation("OrderEventPrepReadyBy")
  ordersFeedbackAssigned          Order[]                  @relation("OrderFeedbackAssignee")
  chefRequisitionsCreated         ChefRequisition[]        @relation("ChefRequisitionCreatedBy")
  chefRequisitionsFulfilled       ChefRequisition[]        @relation("ChefRequisitionFulfilledBy")
  prRequested                     PurchaseRequisition[]    @relation("PRRequester")
  prApproved                      PurchaseRequisition[]    @relation("PRApprover")
  vendorPosApproved               VendorPO[]               @relation("VendorPOApprovedBy")
  vendorPosManagerApproved        VendorPO[]               @relation("VendorPOManagerApprovedBy")
  vendorPosAdminApproved          VendorPO[]               @relation("VendorPOAdminApprovedBy")
  grnsReceived                    GRN[]                    @relation("GRNReceivedBy")
  vendorBillsMatched              VendorBill[]             @relation("VendorBillMatchedBy")
  vendorBillsApproved             VendorBill[]             @relation("VendorBillApprovedBy")
  customerInvoicePaymentsRecorded CustomerInvoicePayment[] @relation("CustomerInvoicePaymentRecordedBy")
  customerInvoicePaymentsReversed CustomerInvoicePayment[] @relation("CustomerInvoicePaymentReversedBy")
  vendorBillPaymentsRecorded      VendorBillPayment[]      @relation("VendorBillPaymentRecordedBy")
  vendorBillPaymentsReversed      VendorBillPayment[]      @relation("VendorBillPaymentReversedBy")
  documentsUploaded               Document[]               @relation("DocumentUploadedBy")
  pettyCashFloats                 PettyCashFloat[]
  pettyCashVouchersCreated        PettyCashVoucher[]       @relation("PettyCashVoucherCreatedBy")
  pettyCashVouchersApproved       PettyCashVoucher[]       @relation("PettyCashVoucherApprovedBy")
  pettyCashTopUpsApproved         PettyCashTopUp[]         @relation("PettyCashTopUpApprovedBy")
  salaryStructures                SalaryStructure[]        @relation("SalaryStructureEmployee")
  salaryRunsCreated               SalaryRun[]              @relation("SalaryRunCreatedBy")
  salaryRunsApproved              SalaryRun[]              @relation("SalaryRunApprovedBy")

  // Task assignment
  tasksAssignedTo Task[] @relation("TaskAssignedTo")
  tasksAssignedBy Task[] @relation("TaskAssignedBy")
  tasksReviewed   Task[] @relation("TaskReviewedBy")

  // Housekeeping
  housekeepingReceiptsRecorded HousekeepingReceipt[] @relation("HousekeepingReceiptRecordedBy")
  housekeepingIssuesRecorded   HousekeepingIssue[]   @relation("HousekeepingIssueRecordedBy")

  // Maintenance
  maintenanceReceiptsRecorded   MaintenanceReceipt[]  @relation("MaintenanceReceiptRecordedBy")
  maintenanceActivitiesRecorded MaintenanceActivity[] @relation("MaintenanceActivityRecordedBy")

  // Banquet (F&B store)
  banquetReceiptsRecorded      BanquetReceipt[]       @relation("BanquetReceiptRecordedBy")
  banquetIssuesRecorded        BanquetIssue[]         @relation("BanquetIssueRecordedBy")
  banquetReturnsRecorded       BanquetReturn[]        @relation("BanquetReturnRecordedBy")
  banquetRequisitionsCreated   BanquetRequisition[]   @relation("BanquetRequisitionCreatedBy")
  banquetRequisitionsFulfilled BanquetRequisition[]   @relation("BanquetRequisitionFulfilledBy")
  staffAllocationsMade         OrderStaffAllocation[] @relation("StaffAllocationBy")
  orderRevisionsMade           OrderRevision[]        @relation("OrderRevisionRevisedBy")
  orderTemplatesCreated        OrderTemplate[]        @relation("OrderTemplateCreatedBy")
  vendorAdvancesRecorded       VendorAdvance[]        @relation("VendorAdvanceRecordedBy")
  leftoverReturnsRecorded      OrderLeftoverReturn[]  @relation("LeftoverReturnBy")

  // Hired casual labour — see model ManpowerRequest.
  manpowerRequested ManpowerRequest[] @relation("ManpowerRequestedBy")
  manpowerApproved  ManpowerRequest[] @relation("ManpowerApprovedBy")
  manpowerRejected  ManpowerRequest[] @relation("ManpowerRejectedBy")
  manpowerCompleted ManpowerRequest[] @relation("ManpowerCompletedBy")
  manpowerSettled   ManpowerRequest[] @relation("ManpowerSettledBy")
  manpowerPaid      ManpowerRequest[] @relation("ManpowerPaidBy")

  productionItemsHandedOver ProductionJobItem[] @relation("ProductionItemHandedOverBy")
  // Notifications (Phase 5)
  notifications             Notification[]      @relation("NotificationToUser")

  // Mobile
  mobileSessions MobileSession[] @relation("MobileSessions")
  mobileOps      MobileOp[]      @relation("MobileOps")
  mobileDevices  MobileDevice[]  @relation("MobileDevices")
}

model EmployeeRateCard {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          EmploymentType
  hourlyRate    Decimal?       @db.Decimal(10, 2)
  monthlySalary Decimal?       @db.Decimal(12, 2)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime       @default(now())

  @@index([userId, effectiveFrom])
}

// =====================================================================
// CUSTOMER (CRM)
// =====================================================================

model CustomerGroup {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String?
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customers Customer[]

  @@index([active])
}

model Customer {
  id              String         @id @default(cuid())
  name            String
  gstin           String?
  pan             String?
  billingAddress  String
  shippingAddress String?
  stateCode       String // 2-digit GST state code, e.g. "29" for Karnataka
  contactName     String?
  email           String?
  phone           String?
  notes           String?
  active          Boolean        @default(true)
  groupId         String?
  group           CustomerGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  // TDS defaults: pre-fill the payment form when this customer typically
  // deducts tax at source. Both nullable; null = no default.
  defaultTdsRatePct Decimal? @db.Decimal(5, 2)
  defaultTdsSection String?

  // Optional "bill to" company — when the legal entity on the invoice
  // differs from the contact person on the order (e.g. branch contact
  // vs. parent company). Falls back to `name` when null.
  billingCompanyName String?

  // Credit & terms
  // creditLimit:   max outstanding the customer can hold across open
  //                invoices before sales is blocked from raising a new
  //                order (enforced at order creation in Phase 1+).
  // creditDays:    payment duration in days. Authoritative integer for
  //                approval routing per the Workflow doc:
  //                  ≤15 → Manager approval is sufficient
  //                  >15 → Admin approval mandatory
  //                Null/0 = cash / immediate. Replaces the older
  //                paymentTerms enum, which we keep around for the
  //                payment-form preset dropdown.
  creditLimit  Decimal            @default(0) @db.Decimal(14, 2)
  creditDays   Int                @default(0)
  paymentTerms VendorPaymentTerms @default(NET_30)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders         Order[]
  quotes         Quote[]
  invoices       CustomerInvoice[]
  orderTemplates OrderTemplate[]

  @@unique([name, gstin])
  @@index([name])
  @@index([active])
  @@index([groupId])
}

// =====================================================================
// DISH + RECIPE (BOM)
// =====================================================================

// Which order channels a dish belongs to. The two client menus map to:
//   BANQUET — banquet / ODC / packet  (the bulk "DOC" menu, package-priced)
//   SERVICE — room service / à la carte / management  (the priced Excel menu)
//   BOTH    — available everywhere (default for legacy dishes)
enum DishMenu {
  BANQUET
  SERVICE
  BOTH
}

model Dish {
  id          String   @id @default(cuid())
  code        String?  @unique // optional human-friendly code, e.g. "PBM-01"
  name        String
  category    String? // free-text section, e.g. "Soups", "Veg Main Course"
  menu        DishMenu @default(BOTH) // which channels offer this dish
  description String?
  unitPrice   Decimal  @db.Decimal(12, 2) // default selling price per portion
  unit        String   @default("portion") // 'portion' | 'plate' | 'kg' etc.
  hsnSac      String? // for GST invoicing
  gstRatePct  Decimal  @default(5) @db.Decimal(5, 2) // catering services in India ~5%
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  recipe             Recipe?
  orderItems         OrderItem[]
  quoteLines         QuoteLine[]
  productionJobItems ProductionJobItem[]
  templateItems      OrderTemplateItem[]

  @@index([active])
  @@index([category])
  @@index([menu])
}

// A Recipe is the BOM for either:
//   - a Dish (recipe.dishId set, recipe.isSubRecipe = false)
//   - a reusable sub-preparation (dishId null, isSubRecipe = true), used by other recipes
model Recipe {
  id                   String   @id @default(cuid())
  name                 String // for sub-recipes only; for dish recipes derived from dish.name
  dishId               String?  @unique
  dish                 Dish?    @relation(fields: [dishId], references: [id])
  isSubRecipe          Boolean  @default(false)
  yieldQty             Decimal  @default(1) @db.Decimal(12, 3)
  yieldUnit            String   @default("portion")
  standardYieldPercent Decimal  @default(100) @db.Decimal(5, 2) // shrinkage between input and output
  notes                String?
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  ingredients RecipeIngredient[]

  // Sub-recipe relations
  parentLinks RecipeSubRecipe[] @relation("ParentRecipe") // recipes that *use* this as a sub-recipe
  childLinks  RecipeSubRecipe[] @relation("ChildRecipe") // sub-recipes that *this recipe* uses

  @@index([isSubRecipe])
  @@index([active])
}

model RecipeIngredient {
  id             String     @id @default(cuid())
  recipeId       String
  recipe         Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientId   String
  ingredient     Ingredient @relation(fields: [ingredientId], references: [id])
  qty            Decimal    @db.Decimal(14, 3)
  unit           String // free text — display only; the canonical unit is ingredient.unit
  wastagePercent Decimal    @default(0) @db.Decimal(5, 2)
  notes          String?

  @@index([recipeId])
  @@index([ingredientId])
}

model RecipeSubRecipe {
  id       String  @id @default(cuid())
  parentId String
  parent   Recipe  @relation("ParentRecipe", fields: [parentId], references: [id], onDelete: Cascade)
  childId  String
  child    Recipe  @relation("ChildRecipe", fields: [childId], references: [id])
  quantity Decimal @db.Decimal(14, 3) // how many yieldQty units of the child are needed
  notes    String?

  @@unique([parentId, childId])
  @@index([childId])
}

// =====================================================================
// INGREDIENT (renamed from Material) + INVENTORY
// =====================================================================

// Sub-store discriminator for chef-side stock. The Workflow doc + the
// "General Information" approval matrix treat Vegetable and Grocery
// (and Water bottles, Milk/Curd) as separate stores with different
// approval rules. We keep one Ingredient table (so Recipe + OrderItem
// links stay untouched) and route requisition approvals on this enum.
enum IngredientSubStore {
  VEGETABLE // chef-side produce
  GROCERY // chef-side staples (dals, rice, flours, spices, oils)
  MILK // milk, curd, dairy
  WATER // packaged water bottles, cans
  OTHER // anything that doesn't fit; default for backfills
}

model Ingredient {
  id                String             @id @default(cuid())
  // GP item code (GP-001…) assigned by nextGPItemCode from a counter shared
  // with BanquetItem — one code never means two different items.
  sku               String             @unique
  // Whatever `sku` held before the GP codes went in (supplier part numbers,
  // import codes). Kept so the switch is reversible; nothing reads it.
  legacySku         String?
  name              String
  category          String? // free-text legacy category — kept for backwards compat
  // Single source of truth for approval routing per the workflow matrix.
  // Backfilled to OTHER on existing rows; UI lets you reclassify.
  subStore          IngredientSubStore @default(OTHER)
  unit              String // 'kg' | 'g' | 'L' | 'mL' | 'pcs' | 'pkt' ...
  openingQty        Decimal            @default(0) @db.Decimal(14, 3)
  openingAvgCost    Decimal            @default(0) @db.Decimal(12, 4)
  onHandQty         Decimal            @default(0) @db.Decimal(14, 3)
  avgUnitCost       Decimal            @default(0) @db.Decimal(12, 4)
  reorderLevel      Decimal            @default(0) @db.Decimal(14, 3)
  preferredVendorId String?
  preferredVendor   Vendor?            @relation("PreferredVendor", fields: [preferredVendorId], references: [id])
  hsnSac            String?
  gstRatePct        Decimal            @default(0) @db.Decimal(5, 2)
  active            Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  receipts             IngredientReceipt[]
  issues               IngredientIssue[]
  adjustments          IngredientAdjustment[]
  recipeIngredients    RecipeIngredient[]
  prLines              PurchaseRequisitionLine[]
  orderBudgetLines     OrderBudgetLine[]         @relation("OrderBudgetLineToIngredient")
  vendorPOLines        VendorPOLine[]            @relation("VendorPOLineToIngredient")
  chefRequisitionLines ChefRequisitionLine[]

  @@index([active])
  @@index([category])
  @@index([subStore])
  @@index([preferredVendorId])
}

model IngredientReceipt {
  id           String     @id @default(cuid())
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  qty          Decimal    @db.Decimal(14, 3)
  unitCost     Decimal    @db.Decimal(12, 4)
  supplier     String? // free text when not tied to a GRN
  receivedAt   DateTime
  note         String?
  // Backref when this receipt was created from a GRN (one GRN line → one
  // IngredientReceipt). Nullable for direct/manual receipts.
  grnLineId    String?    @unique
  grnLine      GRNLine?   @relation(fields: [grnLineId], references: [id])
  // Who recorded this receipt. Nullable for legacy rows and GRN-sourced
  // receipts where the user is implicit on the GRN itself.
  recordedById String?
  recordedBy   User?      @relation("IngredientReceiptRecordedBy", fields: [recordedById], references: [id])
  createdAt    DateTime   @default(now())

  @@index([ingredientId, receivedAt])
  @@index([recordedById])
}

// Manual stock corrections. Storekeeper records new stock through
// IngredientReceipt (cost + supplier known); IngredientAdjustment is the
// admin/manager-only path for write-offs, opening-balance fixes, and any
// quantity edit that isn't a purchase. Every adjustment captures a reason
// and the absolute before/after on-hand for traceability; an AuditLog row
// is written in the same transaction.
model IngredientAdjustment {
  id           String     @id @default(cuid())
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  // Signed delta applied. Positive = stock found / opening fix up;
  // negative = write-off / spoilage / opening fix down.
  delta        Decimal    @db.Decimal(14, 3)
  beforeQty    Decimal    @db.Decimal(14, 3)
  afterQty     Decimal    @db.Decimal(14, 3)
  reason       String
  note         String?
  adjustedById String
  adjustedBy   User       @relation("IngredientAdjustmentAdjustedBy", fields: [adjustedById], references: [id])
  adjustedAt   DateTime   @default(now())

  @@index([ingredientId, adjustedAt])
  @@index([adjustedById])
}

model IngredientIssue {
  id                    String                   @id @default(cuid())
  ingredientId          String
  ingredient            Ingredient               @relation(fields: [ingredientId], references: [id])
  // Optional: usually an issue serves an order, but a standalone (order-less)
  // chef requisition issues stock with no order attached.
  orderId               String?
  order                 Order?                   @relation(fields: [orderId], references: [id])
  productionJobId       String?
  productionJob         ProductionJob?           @relation(fields: [productionJobId], references: [id])
  qty                   Decimal                  @db.Decimal(14, 3)
  unitCostAtIssue       Decimal                  @db.Decimal(12, 4)
  issuedById            String
  issuedBy              User                     @relation(fields: [issuedById], references: [id])
  issuedAt              DateTime
  note                  String?
  // Backref when this issue was created to fulfill a PR line.
  prLineId              String?
  prLine                PurchaseRequisitionLine? @relation(fields: [prLineId], references: [id])
  // Backref when this issue was created to fulfill a chef requisition
  // line. Most production issues will have this set; only direct
  // emergency issues (no requisition) leave it null.
  chefRequisitionLineId String?
  chefRequisitionLine   ChefRequisitionLine?     @relation(fields: [chefRequisitionLineId], references: [id])
  createdAt             DateTime                 @default(now())

  returnLines IngredientReturnLine[]

  @@index([orderId, issuedAt])
  @@index([ingredientId, issuedAt])
  @@index([prLineId])
  @@index([chefRequisitionLineId])
}

// Ingredients coming BACK from the kitchen — the chef drew 5 kg of onions,
// used 3, and the other 2 have to reach the store again. Mirrors
// BanquetReturn (the F&B store's version) with the one addition the money
// requires: every line names the IngredientIssue it reverses, so the credit
// lands on the order that was charged, at the price it was charged at. A
// return tied only to the item would credit whichever event happened to be
// open — which is exactly why food cost is overstated today.
model IngredientReturn {
  id           String   @id @default(cuid())
  returnedAt   DateTime
  recordedById String
  recordedBy   User     @relation("IngredientReturnRecordedBy", fields: [recordedById], references: [id])
  notes        String?
  createdAt    DateTime @default(now())

  lines IngredientReturnLine[]

  @@index([returnedAt])
}

model IngredientReturnLine {
  id       String           @id @default(cuid())
  returnId String
  return   IngredientReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  issueId  String
  issue    IngredientIssue  @relation(fields: [issueId], references: [id])
  quantity Decimal          @db.Decimal(14, 3)
  // Snapshot of the issue's unitCostAtIssue: the value credited back is
  // quantity × this, never quantity × today's moving average.
  unitCost Decimal          @db.Decimal(12, 4)
  // Mandatory — "unused", "excess", "wrong item" or free text. This is what
  // makes the food-cost correction auditable after the event.
  reason   String

  @@index([returnId])
  @@index([issueId])
}

// The three stores keep separate catalogues (Ingredient / BanquetItem /
// HousekeepingItem), so a transfer is never one row's quantity moving: it
// decrements a row in store A and increments a DIFFERENT row in store B.
enum StockStore {
  KITCHEN
  FNB
  HOUSEKEEPING
}

model StockTransfer {
  id            String     @id @default(cuid())
  transferredAt DateTime
  recordedById  String
  recordedBy    User       @relation("StockTransferRecordedBy", fields: [recordedById], references: [id])
  fromStore     StockStore
  toStore       StockStore
  // Item ids are polymorphic across three catalogues, so they carry no FK;
  // name and unit are snapshotted instead, which is what a ledger document
  // should show anyway and survives an item being deleted.
  fromItemId    String
  fromItemName  String
  fromUnit      String
  toItemId      String
  toItemName    String
  toUnit        String
  quantity      Decimal    @db.Decimal(14, 3)
  // Cost carried across, so the source's value drops by exactly what the
  // destination gains. Null when the source store keeps no valuation — only
  // the kitchen tracks avgUnitCost.
  unitCost      Decimal?   @db.Decimal(12, 4)
  notes         String?
  createdAt     DateTime   @default(now())

  @@index([transferredAt])
  @@index([fromItemId])
  @@index([toItemId])
}

// =====================================================================
// QUOTE
// =====================================================================

model Quote {
  id         String   @id @default(cuid())
  quoteNo    String   @unique
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  orderId    String?  @unique
  order      Order?   @relation("QuoteConvertedOrder", fields: [orderId], references: [id])
  title      String

  // Catering-specific
  eventDate       DateTime?
  headcount       Int?
  mealType        MealType?
  deliveryAddress String?

  status                 QuoteStatus @default(DRAFT)
  version                Int         @default(1)
  parentQuoteId          String?
  parentQuote            Quote?      @relation("QuoteRevisions", fields: [parentQuoteId], references: [id])
  revisions              Quote[]     @relation("QuoteRevisions")
  validUntil             DateTime?
  placeOfSupplyStateCode String
  subtotal               Decimal     @default(0) @db.Decimal(14, 2)
  taxTotal               Decimal     @default(0) @db.Decimal(14, 2)
  grandTotal             Decimal     @default(0) @db.Decimal(14, 2)
  notes                  String?
  termsMd                String?
  createdById            String
  createdBy              User        @relation("QuoteCreatedBy", fields: [createdById], references: [id])
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  sentAt                 DateTime?
  acceptedAt             DateTime?
  convertedAt            DateTime?
  shareToken             String      @unique

  lines  QuoteLine[]
  events QuoteEvent[]

  @@index([status])
  @@index([customerId])
  @@index([createdAt])
}

model QuoteLine {
  id           String  @id @default(cuid())
  quoteId      String
  quote        Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  sortOrder    Int
  dishId       String?
  dish         Dish?   @relation(fields: [dishId], references: [id])
  description  String // freeform line if no dish (e.g. "Setup + service staff")
  hsnSac       String?
  quantity     Decimal @db.Decimal(12, 3)
  unit         String
  unitPrice    Decimal @db.Decimal(12, 2)
  discountPct  Decimal @default(0) @db.Decimal(5, 2)
  gstRatePct   Decimal @default(0) @db.Decimal(5, 2)
  lineSubtotal Decimal @db.Decimal(14, 2)
  lineTax      Decimal @db.Decimal(14, 2)
  lineTotal    Decimal @db.Decimal(14, 2)

  @@index([quoteId, sortOrder])
}

model QuoteEvent {
  id          String         @id @default(cuid())
  quoteId     String
  quote       Quote          @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  kind        QuoteEventKind
  note        String?
  fromStatus  QuoteStatus?
  toStatus    QuoteStatus?
  actorUserId String?
  actor       User?          @relation("QuoteEventActor", fields: [actorUserId], references: [id])
  at          DateTime       @default(now())

  @@index([quoteId, at])
}

// =====================================================================
// ORDER (renamed from Project)
// =====================================================================

model Order {
  id         String   @id @default(cuid())
  code       String   @unique // ORD-26-27-0001
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  // How this order was taken. Drives line rendering, room/table
  // tracking, approval routing in later phases.
  channel OrderChannel @default(BANQUET)

  // Catering-specific
  eventDate           DateTime
  headcount           Int
  mealType            MealType
  deliveryAddress     String
  deliveryWindowStart DateTime
  deliveryWindowEnd   DateTime

  // F&B service identifiers — required at the validator level when
  // channel is ROOM_SERVICE / ALACARTE; one of room or table is enough.
  roomNumber  String?
  tableNumber String?

  // WhatsApp / public feedback link. Generated on order completion
  // (Phase 4 stub — actual WhatsApp send wires up later). Customers
  // click /f/<token> to leave a review. feedbackRating is 1..5;
  // feedbackComment is free text. Both null until the customer fills
  // in the public form.
  feedbackToken       String?   @unique
  feedbackSentAt      DateTime?
  feedbackRating      Int?
  feedbackComment     String?
  feedbackSubmittedAt DateTime?

  // Feedback collection allocation — a manager assigns a staff member to
  // chase the customer's feedback for this order. Null until allocated.
  feedbackAssigneeId   String?
  feedbackAssignee     User?     @relation("OrderFeedbackAssignee", fields: [feedbackAssigneeId], references: [id])
  feedbackAssignedAt   DateTime?
  feedbackAssignedById String?

  // Set when the kitchen taps "Hand to delivery" / "Send to dispatch" — the
  // delivery team has been pinged. The order stays READY until a delivery is
  // actually scheduled; this just lets the kitchen card show "Delivery
  // informed" instead of the action button after they've intimated.
  handedToDeliveryAt DateTime?

  // Off-site catering (banquet / ODC / packed): the delivery team prepares
  // cutlery, crockery and event arrangements ahead of the event and marks
  // them ready here. Null until they tap "Mark event prep ready".
  eventPrepReadyAt   DateTime?
  eventPrepReadyById String?
  eventPrepReadyBy   User?     @relation("OrderEventPrepReadyBy", fields: [eventPrepReadyById], references: [id])
  // Explicit "no cutlery required" choice — every event either issues
  // cutlery or logs that none was needed; no silent skips.
  eventPrepNoCutlery Boolean   @default(false)

  status                 OrderStatus @default(DRAFT)
  contractValue          Decimal     @db.Decimal(14, 2)
  placeOfSupplyStateCode String
  notes                  String?

  // Recipe-derived suggestion snapshot (only populated when Settings
  // `recipe.suggestionsEnabled` is on AND the dishes on this order have
  // recipes). Used to PRE-FILL the chef's requisition screen. Never the
  // source of truth for "planned cost" — that lives in ChefRequisition.
  // Shape: { ingredients: [{ ingredientId, qty, unitCostSnapshot }], totalCost }
  recipeSuggestionSnapshot Json?

  // ---------- Two-stage approval ----------
  // Stage 1: Store keeper signs off stock-availability. Required, with a note.
  // Stage 2: Manager signs off price + business.
  // Manager may OVERRIDE a store rejection (sets storeOverriddenAt + reason).

  // Submission
  submittedAt DateTime?

  // Store approval (stage 1)
  storeReviewedById String?
  storeReviewedBy   User?             @relation("OrderStoreReviewedBy", fields: [storeReviewedById], references: [id])
  storeReviewedAt   DateTime?
  storeDecision     ApprovalDecision?
  storeApprovalNote String? // Store MUST write a note. Free-text flags concerns about specific dishes / ingredients.

  // Manager approval (stage 2)
  managerReviewedById String?
  managerReviewedBy   User?             @relation("OrderManagerReviewedBy", fields: [managerReviewedById], references: [id])
  managerReviewedAt   DateTime?
  managerDecision     ApprovalDecision?
  managerApprovalNote String?

  // Manager override of a store rejection. When set, managerDecision is
  // OVERRIDDEN and the order resumes from APPROVED. The override reason is
  // captured separately so the audit trail can show "Store said X, Manager
  // overrode because Y".
  managerOverrideReason String?

  // Admin gate (workflow v3). Every submitted order — including those
  // raised by an admin themselves — sits at PENDING_ADMIN_APPROVAL until
  // an ADMIN approves it. Approval flips the status to
  // PENDING_CHEF_APPROVAL so the kitchen flow takes over.
  adminReviewedById String?
  adminReviewedBy   User?             @relation("OrderAdminReviewedBy", fields: [adminReviewedById], references: [id])
  adminReviewedAt   DateTime?
  adminDecision     ApprovalDecision?
  adminReviewNote   String?

  // Chef-first review (workflow v2).
  // After admin approval the order lands at PENDING_CHEF_APPROVAL. The
  // chef either confirms (chefDecision=APPROVED, advances to
  // CHEF_REQUISITION_PENDING) or proposes changes
  // (chefDecision=SUGGESTED_CHANGES, chefSuggestionNotes populated,
  // advances to CHANGES_PROPOSED_BY_CHEF for the manager).
  chefReviewedById    String?
  chefReviewedBy      User?             @relation("OrderChefReviewedBy", fields: [chefReviewedById], references: [id])
  chefReviewedAt      DateTime?
  chefDecision        ApprovalDecision?
  chefSuggestionNotes String?

  // Manager review of the chef's proposed changes. APPROVED here flips the
  // order back into the chef's queue at CHEF_REQUISITION_PENDING; REJECTED
  // is terminal (REJECTED_BY_MANAGER).
  managerChangeReviewedById String?
  managerChangeReviewedBy   User?             @relation("OrderManagerChangeReviewedBy", fields: [managerChangeReviewedById], references: [id])
  managerChangeReviewedAt   DateTime?
  managerChangeDecision     ApprovalDecision?
  managerChangeNote         String?

  // Revision alerting. lastRevisedAt is stamped on every revision (null =
  // never revised); the two seen-stamps are cleared by that same write, so a
  // fresh revision re-alerts a team that acknowledged the previous one.
  lastRevisedAt         DateTime?
  revisionSeenByChefAt  DateTime?
  revisionSeenByStoreAt DateTime?

  // Workflow
  kitchenSupervisorId String?
  kitchenSupervisor   User?     @relation("KitchenSupervisor", fields: [kitchenSupervisorId], references: [id])
  cancelledAt         DateTime?
  cancellationReason  String?

  createdById String
  createdBy   User     @relation("OrderCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items                 OrderItem[]
  budgetLines           OrderBudgetLine[]
  overheadAllocs        OrderOverheadAllocation[]
  ingredientIssues      IngredientIssue[]
  quote                 Quote?                    @relation("QuoteConvertedOrder")
  productionJobs        ProductionJob[]
  deliveries            Delivery[]
  invoices              CustomerInvoice[]
  prs                   PurchaseRequisition[]
  vendorPos             VendorPO[]                @relation("VendorPOToOrder")
  timeEntries           TimeEntry[]               @relation("TimeEntryToOrder")
  chefRequisitions      ChefRequisition[]
  banquetIssues         BanquetIssue[]            @relation("BanquetIssueOrder")
  banquetReturns        BanquetReturn[]           @relation("BanquetReturnOrder")
  banquetRequisitions   BanquetRequisition[]      @relation("BanquetRequisitionOrder")
  // The consolidated in-house (folio) invoice that billed this order, when
  // billed via the folio screen rather than per-order. Payment / cancel
  // paths advance or revert member orders through this link.
  consolidatedInvoiceId String?
  consolidatedInvoice   CustomerInvoice?          @relation("ConsolidatedInvoiceOrders", fields: [consolidatedInvoiceId], references: [id])
  staffAllocations      OrderStaffAllocation[]
  leftoverReturns       OrderLeftoverReturn[]
  orderRevisions        OrderRevision[]
  // Hired casual labour raised against this order. Purely informational
  // for the order — nothing here ever moves Order.status.
  manpowerRequests      ManpowerRequest[]         @relation("ManpowerRequestOrder")

  @@index([status])
  @@index([customerId])
  @@index([eventDate])
  @@index([kitchenSupervisorId])
  @@index([storeReviewedById])
  @@index([managerReviewedById])
  @@index([chefReviewedById])
  @@index([managerChangeReviewedById])
  @@index([adminReviewedById])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dishId       String
  dish         Dish    @relation(fields: [dishId], references: [id])
  sortOrder    Int
  portions     Decimal @db.Decimal(12, 3)
  unitPrice    Decimal @db.Decimal(12, 2)
  discountPct  Decimal @default(0) @db.Decimal(5, 2)
  gstRatePct   Decimal @default(0) @db.Decimal(5, 2)
  lineSubtotal Decimal @db.Decimal(14, 2)
  lineTax      Decimal @db.Decimal(14, 2)
  lineTotal    Decimal @db.Decimal(14, 2)
  notes        String?

  chefRequisitionLines ChefRequisitionLine[]

  @@index([orderId, sortOrder])
  @@index([dishId])
}

model OrderBudgetLine {
  id           String         @id @default(cuid())
  orderId      String
  order        Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  category     BudgetCategory
  description  String
  ingredientId String?
  ingredient   Ingredient?    @relation(fields: [ingredientId], references: [id], name: "OrderBudgetLineToIngredient")
  quantity     Decimal        @db.Decimal(12, 3)
  unitCost     Decimal        @db.Decimal(12, 2)
  total        Decimal        @db.Decimal(14, 2)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([orderId, category])
}

model OrderOverheadAllocation {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  periodMonth DateTime
  amount      Decimal  @db.Decimal(14, 2)
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([orderId, periodMonth])
  @@index([periodMonth])
}

// =====================================================================
// CHEF REQUISITION (chef → store internal request, scoped to one order)
// =====================================================================
// The chef raises a requisition stating what they actually need for a
// specific order. The store fulfills line-by-line: any line that can't
// be issued from stock spawns a PurchaseRequisition. When ALL lines are
// FULLY_ISSUED, the order auto-advances to READY_FOR_PRODUCTION.
//
// Distinct from PurchaseRequisition (which is store → vendor). The
// vocabulary is intentional: "requisition" inside the kitchen, "purchase
// requisition" to vendors.

model ChefRequisition {
  id                String                @id @default(cuid())
  requisitionNo     String                @unique // CR-26-27-0001
  // Optional: a requisition usually serves an order, but the chef can also
  // raise a general/standalone stock request not tied to any order.
  orderId           String?
  order             Order?                @relation(fields: [orderId], references: [id])
  status            ChefRequisitionStatus @default(DRAFT)
  notes             String?
  createdById       String // the chef
  createdBy         User                  @relation("ChefRequisitionCreatedBy", fields: [createdById], references: [id])
  submittedAt       DateTime?
  // Last storekeeper to act on this requisition (issue or create PR).
  // Updated each time the store touches a line; not a single authoritative
  // owner.
  lastFulfilledById String?
  lastFulfilledBy   User?                 @relation("ChefRequisitionFulfilledBy", fields: [lastFulfilledById], references: [id])
  closedAt          DateTime?
  // Chef re-checked these quantities against the order's latest revision.
  // Older than Order.lastRevisedAt (or null) = still stale.
  revisionAckAt     DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  lines ChefRequisitionLine[]
  // PRs auto-created from shortages on this requisition (one PR may cover
  // multiple ChefRequisitionLines; one ChefRequisitionLine may be split
  // across multiple PRs in degenerate cases — the link is via the line).
  prs   PurchaseRequisition[]

  @@index([status])
  @@index([orderId])
  @@index([createdById])
}

model ChefRequisitionLine {
  id               String                    @id @default(cuid())
  requisitionId    String
  requisition      ChefRequisition           @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  ingredientId     String
  ingredient       Ingredient                @relation(fields: [ingredientId], references: [id])
  // Optional reference to which dish on the order this line is for.
  // Nullable because chef may bundle ingredients (e.g. 5kg onion for
  // 3 different dishes). Useful for production analytics, not enforced.
  orderItemId      String?
  orderItem        OrderItem?                @relation(fields: [orderItemId], references: [id])
  requestedQty     Decimal                   @db.Decimal(14, 3)
  unit             String // display unit; canonical = ingredient.unit
  issuedQty        Decimal                   @default(0) @db.Decimal(14, 3)
  // Snapshot of ingredient avgUnitCost at requisition-submit time. This is
  // the "planned cost" baseline for budget-vs-actual on the order.
  unitCostSnapshot Decimal                   @db.Decimal(12, 4)
  status           ChefRequisitionLineStatus @default(PENDING)
  notes            String?
  // The PO line buying this line's shortfall (set when the store raises a
  // PO from the requisition); GRN acceptance flips the line back to PENDING
  // so the store issues it — mirrors BanquetRequisitionLine.vendorPOLineId.
  vendorPOLineId   String?
  vendorPOLine     VendorPOLine?             @relation("ChefReqLineToPOLine", fields: [vendorPOLineId], references: [id])

  ingredientIssues IngredientIssue[]

  @@index([requisitionId])
  @@index([ingredientId])
  @@index([status])
  @@index([orderItemId])
}

// =====================================================================
// PRODUCTION (kitchen board)
// =====================================================================

model ProductionJob {
  id             String              @id @default(cuid())
  jobNo          String              @unique // PJ-26-27-0001
  orderId        String
  order          Order               @relation(fields: [orderId], references: [id])
  status         ProductionJobStatus @default(QUEUED)
  scheduledStart DateTime
  scheduledReady DateTime
  actualStart    DateTime?
  actualReady    DateTime?
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  items            ProductionJobItem[]
  ingredientIssues IngredientIssue[]

  @@index([status])
  @@index([orderId])
  @@index([scheduledReady])
}

model ProductionJobItem {
  id             String                  @id @default(cuid())
  jobId          String
  job            ProductionJob           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  dishId         String
  dish           Dish                    @relation(fields: [dishId], references: [id])
  portions       Decimal                 @db.Decimal(12, 3)
  status         ProductionJobItemStatus @default(QUEUED)
  chefUserId     String?
  chef           User?                   @relation("ChefAssignedTo", fields: [chefUserId], references: [id])
  startedAt      DateTime?
  readyAt        DateTime?
  // Kitchen → delivery handover, per dish: stamped the moment this item
  // is physically given to the delivery team. The order-level
  // handedToDeliveryAt completes when the LAST item is stamped — so a
  // late fifth dish is attributable to the kitchen, not the driver.
  handedOverAt   DateTime?
  handedOverById String?
  handedOverBy   User?                   @relation("ProductionItemHandedOverBy", fields: [handedOverById], references: [id])
  notes          String?

  @@index([jobId])
  @@index([dishId])
  @@index([chefUserId])
}

// =====================================================================
// DELIVERY
// =====================================================================

model Delivery {
  id             String         @id @default(cuid())
  deliveryNo     String         @unique // DLV-26-27-0001
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id])
  status         DeliveryStatus @default(SCHEDULED)
  driverUserId   String?
  driver         User?          @relation("DriverAssignedTo", fields: [driverUserId], references: [id])
  vehicleNo      String?
  scheduledAt    DateTime
  dispatchedAt   DateTime?
  arrivedAt      DateTime?
  deliveredAt    DateTime?
  otpHash        String? // bcrypt-hashed 4-digit OTP
  otpAttempts    Int            @default(0)
  recipientName  String?
  recipientPhone String?
  proofPhotoUrls String[]       @default([])
  signatureUrl   String?
  failureReason  String?
  notes          String?

  // Payment collected at delivery (Phase 3+ workflow). When the driver
  // confirms OTP, they can also mark whether they collected payment on
  // the spot. If true, a CustomerInvoicePayment row is auto-created
  // against the order's invoice in the same transaction.
  paymentCollected  Boolean?  @default(false)
  paymentAmount     Decimal?  @db.Decimal(14, 2)
  paymentMethod     String? // 'CASH' | 'UPI' | 'CHEQUE' | 'NEFT' | 'OTHER'
  paymentReference  String? // UPI ref / cheque no
  paymentRecordedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attempts DeliveryAttempt[]

  @@index([status])
  @@index([orderId])
  @@index([scheduledAt])
  @@index([driverUserId])
}

model DeliveryAttempt {
  id          String   @id @default(cuid())
  deliveryId  String
  delivery    Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  attemptedAt DateTime @default(now())
  outcome     String // 'OTP_MATCH' | 'OTP_MISMATCH' | 'CUSTOMER_UNAVAILABLE' | 'WRONG_ADDRESS' | 'OTHER'
  notes       String?

  @@index([deliveryId, attemptedAt])
}

// =====================================================================
// PROCUREMENT — PurchaseRequisition → VendorPO → GRN → VendorBill
// =====================================================================

// New vendors created by the store need GM/Admin sign-off before POs can
// be raised on them (client #12). Existing vendors default APPROVED.
enum VendorApprovalStatus {
  PENDING_APPROVAL
  APPROVED
}

model Vendor {
  id                String               @id @default(cuid())
  code              String               @unique // V-0001
  name              String
  gstin             String?
  pan               String?
  stateCode         String
  category          VendorCategory       @default(OTHER)
  msme              Boolean              @default(false)
  contactName       String?
  phone             String?
  email             String?
  address           String?
  paymentTerms      VendorPaymentTerms   @default(NET_30)
  creditLimit       Decimal              @default(0) @db.Decimal(14, 2)
  notes             String?
  active            Boolean              @default(true)
  approvalStatus    VendorApprovalStatus @default(APPROVED)
  // Statutory / recurring service vendors (electricity, rent, GST,
  // telecom, statutory body). Triggers a reminder Task 3 days before
  // the next bill's due date — and an immediate one if any of their
  // bills is currently past-due. See server/actions/reminders.ts.
  isStatutory       Boolean              @default(false)
  defaultTdsRatePct Decimal?             @db.Decimal(5, 2)
  defaultTdsSection String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  purchaseOrders        VendorPO[]
  bills                 VendorBill[]
  preferredByIngredient Ingredient[]    @relation("PreferredVendor")
  advances              VendorAdvance[]

  @@index([active])
  @@index([category])
  @@index([name])
}

model PurchaseRequisition {
  id                String                    @id @default(cuid())
  prNo              String                    @unique // PR-26-27-0001
  orderId           String? // optional link to the catering order that triggered the shortage
  order             Order?                    @relation(fields: [orderId], references: [id])
  // When this PR was auto-created from a chef requisition shortage,
  // link back so the chef can see "your line is being procured".
  chefRequisitionId String?
  chefRequisition   ChefRequisition?          @relation(fields: [chefRequisitionId], references: [id])
  requestedById     String
  requestedBy       User                      @relation("PRRequester", fields: [requestedById], references: [id])
  status            PurchaseRequisitionStatus @default(DRAFT)
  needsApproval     Boolean                   @default(false) // computed at submit
  approvedById      String?
  approvedBy        User?                     @relation("PRApprover", fields: [approvedById], references: [id])
  approvedAt        DateTime?
  rejectionReason   String?
  notes             String?
  submittedAt       DateTime?
  closedAt          DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  lines PurchaseRequisitionLine[]

  @@index([status])
  @@index([orderId, status])
  @@index([requestedById])
  @@index([chefRequisitionId])
}

model PurchaseRequisitionLine {
  id                String              @id @default(cuid())
  prId              String
  pr                PurchaseRequisition @relation(fields: [prId], references: [id], onDelete: Cascade)
  ingredientId      String
  ingredient        Ingredient          @relation(fields: [ingredientId], references: [id])
  requestedQty      Decimal             @db.Decimal(14, 3)
  unitCostSnapshot  Decimal             @db.Decimal(12, 4)
  isInBudget        Boolean             @default(true)
  reasonOutOfBudget String?
  issuedQty         Decimal             @default(0) @db.Decimal(14, 3)
  notes             String?

  ingredientIssues IngredientIssue[]

  @@index([prId])
  @@index([ingredientId])
}

model VendorPO {
  id                     String          @id @default(cuid())
  poNo                   String          @unique // VPO-26-27-0001
  vendorId               String
  vendor                 Vendor          @relation(fields: [vendorId], references: [id])
  orderId                String? // optional link to the catering order being procured for
  order                  Order?          @relation(fields: [orderId], references: [id], name: "VendorPOToOrder")
  status                 VendorPOStatus  @default(DRAFT)
  issueDate              DateTime        @default(now())
  expectedDate           DateTime?
  placeOfSupplyStateCode String
  subtotal               Decimal         @default(0) @db.Decimal(14, 2)
  taxTotal               Decimal         @default(0) @db.Decimal(14, 2)
  grandTotal             Decimal         @default(0) @db.Decimal(14, 2)
  // approvalTier:
  //   "auto"   — skip approval entirely (rare, explicit override)
  //   "tiered" — apply Settings.po.approvalTiers thresholds:
  //              Manager always required; Admin required when grandTotal
  //              ≥ adminMin (default ₹5000 per Workflow doc).
  //   Legacy values "manager" / "admin" from earlier rollouts are treated
  //   as "tiered" by the engine.
  approvalTier           String          @default("tiered")
  // How the store is procuring this. LOCAL (buy from a local shop) and ONLINE
  // (order online) always require BOTH manager AND admin sign-off, regardless
  // of value. STANDARD keeps the value-tier rule (Manager < ₹5k, Admin ≥ ₹5k).
  procurementType        ProcurementType @default(STANDARD)
  // Final approver — the person who clicked "Approve" on the LAST step
  // (manager-alone for <threshold POs, admin for ≥threshold).
  approvedByUserId       String?
  approvedBy             User?           @relation("VendorPOApprovedBy", fields: [approvedByUserId], references: [id])
  approvedAt             DateTime?
  // Per-step approval breadcrumbs. Both populate on a tiered approval;
  // on a sub-threshold PO only managerApproved* is set + approvedAt
  // points to that timestamp.
  managerApprovedById    String?
  managerApprovedBy      User?           @relation("VendorPOManagerApprovedBy", fields: [managerApprovedById], references: [id])
  managerApprovedAt      DateTime?
  adminApprovedById      String?
  adminApprovedBy        User?           @relation("VendorPOAdminApprovedBy", fields: [adminApprovedById], references: [id])
  adminApprovedAt        DateTime?
  sentAt                 DateTime?
  closedAt               DateTime?
  // Store re-checked this PO against the order's latest revision.
  revisionAckAt          DateTime?
  notes                  String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  lines    VendorPOLine[]
  grns     GRN[]
  bills    VendorBill[]
  advances VendorAdvance[]

  @@index([status])
  @@index([vendorId, issueDate])
  @@index([orderId])
}

model VendorPOLine {
  id            String       @id @default(cuid())
  poId          String
  po            VendorPO     @relation(fields: [poId], references: [id], onDelete: Cascade)
  sortOrder     Int
  // Either link to an Ingredient or stand alone as free text (e.g. one-off purchase)
  ingredientId  String?
  ingredient    Ingredient?  @relation("VendorPOLineToIngredient", fields: [ingredientId], references: [id])
  // Or link to a BanquetItem: POs raised for F&B requisition shortfalls.
  // GRN acceptance auto-posts a BanquetReceipt and bumps the item's stock.
  banquetItemId String?
  banquetItem   BanquetItem? @relation("VendorPOLineToBanquetItem", fields: [banquetItemId], references: [id])
  sku           String
  description   String
  unit          String
  quantity      Decimal      @db.Decimal(14, 3)
  unitPrice     Decimal      @db.Decimal(12, 2)
  gstRatePct    Decimal      @default(0) @db.Decimal(5, 2)
  lineSubtotal  Decimal      @db.Decimal(14, 2)
  lineTax       Decimal      @db.Decimal(14, 2)
  lineTotal     Decimal      @db.Decimal(14, 2)
  receivedQty   Decimal      @default(0) @db.Decimal(14, 3)

  grnLines        GRNLine[]                @relation("GRNLineToPOLine")
  // Requisition lines whose shortfall this PO line is buying.
  banquetReqLines BanquetRequisitionLine[]
  chefReqLines    ChefRequisitionLine[]    @relation("ChefReqLineToPOLine")

  @@index([poId, sortOrder])
  @@index([banquetItemId])
}

model GRN {
  id               String    @id @default(cuid())
  grnNo            String    @unique // GRN-26-27-0001
  poId             String
  po               VendorPO  @relation(fields: [poId], references: [id])
  status           GRNStatus @default(DRAFT)
  receivedAt       DateTime  @default(now())
  receivedByUserId String?
  receivedBy       User?     @relation("GRNReceivedBy", fields: [receivedByUserId], references: [id])
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  lines GRNLine[]

  @@index([poId, receivedAt])
  @@index([status])
}

model GRNLine {
  id          String       @id @default(cuid())
  grnId       String
  grn         GRN          @relation(fields: [grnId], references: [id], onDelete: Cascade)
  poLineId    String
  poLine      VendorPOLine @relation("GRNLineToPOLine", fields: [poLineId], references: [id])
  sortOrder   Int
  orderedQty  Decimal      @db.Decimal(14, 3)
  acceptedQty Decimal      @db.Decimal(14, 3)
  rejectedQty Decimal      @default(0) @db.Decimal(14, 3)
  reason      String?

  ingredientReceipt IngredientReceipt?

  @@index([grnId, sortOrder])
  @@index([poLineId])
}

model VendorBill {
  id                    String           @id @default(cuid())
  billNo                String           @unique // internal: VB-26-27-0001
  vendorBillNo          String? // vendor's printed invoice number
  vendorId              String
  vendor                Vendor           @relation(fields: [vendorId], references: [id])
  poId                  String?
  po                    VendorPO?        @relation(fields: [poId], references: [id])
  status                VendorBillStatus @default(DRAFT)
  issueDate             DateTime         @default(now())
  dueDate               DateTime?
  subtotal              Decimal          @default(0) @db.Decimal(14, 2)
  taxTotal              Decimal          @default(0) @db.Decimal(14, 2)
  grandTotal            Decimal          @default(0) @db.Decimal(14, 2)
  amountPaid            Decimal          @default(0) @db.Decimal(14, 2)
  paidAt                DateTime?
  matchedByUserId       String?
  matchedBy             User?            @relation("VendorBillMatchedBy", fields: [matchedByUserId], references: [id])
  matchedAt             DateTime?
  discrepancyNote       String?
  notes                 String?
  // Who signed off on paying this supplier, and on what terms. The audit log
  // keeps only a payload hash, so anything a human has to read back later
  // (why a mismatched bill was still approved / still edited) lives here.
  approvedByUserId      String?
  approvedBy            User?            @relation("VendorBillApprovedBy", fields: [approvedByUserId], references: [id])
  approvedAt            DateTime?
  /// Why a bill that failed the 3-way match was approved anyway.
  approvalNote          String?
  /// Why accounts changed a mismatched bill's amounts.
  discrepancyEditReason String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  lines           VendorBillLine[]
  payments        VendorBillPayment[]
  advancesApplied VendorAdvance[]

  @@index([status])
  @@index([vendorId, issueDate])
  @@index([dueDate])
}

model VendorBillLine {
  id           String     @id @default(cuid())
  billId       String
  bill         VendorBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  sortOrder    Int
  description  String
  quantity     Decimal    @db.Decimal(14, 3)
  unit         String
  unitPrice    Decimal    @db.Decimal(12, 2)
  gstRatePct   Decimal    @default(0) @db.Decimal(5, 2)
  lineSubtotal Decimal    @db.Decimal(14, 2)
  lineTax      Decimal    @db.Decimal(14, 2)
  lineTotal    Decimal    @db.Decimal(14, 2)

  @@index([billId, sortOrder])
}

// =====================================================================
// CUSTOMER INVOICE + E-INVOICE
// =====================================================================

model CustomerInvoice {
  id                     String                @id @default(cuid())
  invoiceNo              String                @unique // INV-26-27-0001
  kind                   CustomerInvoiceKind   @default(ORDER)
  status                 CustomerInvoiceStatus @default(DRAFT)
  orderId                String?
  order                  Order?                @relation(fields: [orderId], references: [id])
  customerId             String
  customer               Customer              @relation(fields: [customerId], references: [id])
  placeOfSupplyStateCode String
  issuedAt               DateTime?
  dueAt                  DateTime?

  // Money
  subtotal   Decimal   @default(0) @db.Decimal(14, 2)
  cgst       Decimal   @default(0) @db.Decimal(14, 2)
  sgst       Decimal   @default(0) @db.Decimal(14, 2)
  igst       Decimal   @default(0) @db.Decimal(14, 2)
  taxTotal   Decimal   @default(0) @db.Decimal(14, 2)
  grandTotal Decimal   @default(0) @db.Decimal(14, 2)
  amountPaid Decimal   @default(0) @db.Decimal(14, 2)
  paidAt     DateTime?

  // E-invoice (Phase 3)
  eInvoiceStatus    EInvoiceStatus @default(NOT_REQUIRED)
  irn               String?        @unique
  ackNo             String?
  ackDate           DateTime?
  signedQrPayload   String?        @db.Text // signed QR payload string returned by IRP
  signedInvoiceJson Json? // full signed invoice JSON from IRP

  notes       String?
  termsMd     String?
  poRef       String?
  createdById String
  createdBy   User     @relation("CustomerInvoiceCreatedBy", fields: [createdById], references: [id])
  shareToken  String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Email delivery tracking (Phase 3+ workflow). When the system auto-emails
  // a proforma / tax invoice to the customer, capture the timestamp and the
  // destination so the audit trail and the UI can show "Sent to
  // ops@infosys.com at 14:32".
  // Billing hold — wrong address / wrong client / wrong items / payment
  // dispute. A held invoice can't take payments or be emailed until the
  // hold is released.
  onHoldAt     DateTime?
  onHoldReason String?
  onHoldById   String?
  onHoldBy     User?     @relation("CustomerInvoiceOnHoldBy", fields: [onHoldById], references: [id])

  // Manager/admin sign-off, required before a draft may be issued to the
  // customer. Any edit to the draft clears all three — an approval belongs
  // to the numbers it was given for, so a ₹50,000 sign-off must not travel
  // with an ₹80,000 invoice. NULL on every pre-existing invoice.
  approvedAt   DateTime?
  approvedById String?
  approvedBy   User?     @relation("CustomerInvoiceApprovedBy", fields: [approvedById], references: [id])
  approvalNote String?

  // Pax the invoice is actually billed for, snapshotted from the order when
  // the invoice is created and editable by a manager while it's a draft.
  // The printed pax and rate derive from this, not from the live order —
  // changing the order to 120 after invoicing used to leave the document
  // reading "120 pax @ ₹416.67" while still totalling the 100-pax amount.
  finalHeadcount Int?

  emailedAt DateTime?
  emailedTo String?

  lines              CustomerInvoiceLine[]
  payments           CustomerInvoicePayment[]
  eInvoiceLogs       EInvoiceLog[]
  // Orders billed by this consolidated in-house invoice (folio).
  consolidatedOrders Order[]                  @relation("ConsolidatedInvoiceOrders")

  @@index([orderId, issuedAt])
  @@index([status])
  @@index([eInvoiceStatus])
  @@index([customerId])
  @@index([createdAt])
  // Overdue-receivables checks (nav badge, dashboard AR) filter on dueAt.
  @@index([dueAt])
}

model CustomerInvoiceLine {
  id           String          @id @default(cuid())
  invoiceId    String
  invoice      CustomerInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sortOrder    Int
  description  String
  hsnSac       String?
  quantity     Decimal         @db.Decimal(12, 3)
  unit         String
  unitPrice    Decimal         @db.Decimal(12, 2)
  discountPct  Decimal         @default(0) @db.Decimal(5, 2)
  gstRatePct   Decimal         @default(0) @db.Decimal(5, 2)
  lineSubtotal Decimal         @db.Decimal(14, 2)
  lineTax      Decimal         @db.Decimal(14, 2)
  lineTotal    Decimal         @db.Decimal(14, 2)

  @@index([invoiceId, sortOrder])
}

model EInvoiceLog {
  id           String          @id @default(cuid())
  invoiceId    String
  invoice      CustomerInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  action       String // 'GENERATE' | 'CANCEL' | 'RETRY'
  provider     String // 'CLEARTAX' | 'IRIS' | 'NIC_DIRECT' etc.
  requestJson  Json?
  responseJson Json?
  success      Boolean
  errorMessage String?
  at           DateTime        @default(now())

  @@index([invoiceId, at])
}

// =====================================================================
// PAYMENTS
// =====================================================================

model CustomerInvoicePayment {
  id               String          @id @default(cuid())
  invoiceId        String
  invoice          CustomerInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount           Decimal         @db.Decimal(14, 2) // total credit (cash + TDS)
  paidAt           DateTime
  method           PaymentMethod   @default(OTHER)
  reference        String?
  notes            String?
  // TDS — populated only when the customer deducted tax at source.
  tdsAmount        Decimal?        @db.Decimal(14, 2)
  tdsRatePct       Decimal?        @db.Decimal(5, 2)
  tdsSection       String?
  tdsCertificateNo String?
  recordedById     String
  recordedBy       User            @relation("CustomerInvoicePaymentRecordedBy", fields: [recordedById], references: [id])
  createdAt        DateTime        @default(now())
  reversedAt       DateTime?
  reversedReason   String?
  reversedById     String?
  reversedBy       User?           @relation("CustomerInvoicePaymentReversedBy", fields: [reversedById], references: [id])

  @@index([invoiceId, paidAt])
  @@index([paidAt])
}

model VendorBillPayment {
  id               String        @id @default(cuid())
  vendorBillId     String
  vendorBill       VendorBill    @relation(fields: [vendorBillId], references: [id], onDelete: Cascade)
  amount           Decimal       @db.Decimal(14, 2)
  paidAt           DateTime
  method           PaymentMethod @default(OTHER)
  reference        String?
  notes            String?
  tdsAmount        Decimal?      @db.Decimal(14, 2)
  tdsRatePct       Decimal?      @db.Decimal(5, 2)
  tdsSection       String?
  tdsCertificateNo String?
  recordedById     String
  recordedBy       User          @relation("VendorBillPaymentRecordedBy", fields: [recordedById], references: [id])
  createdAt        DateTime      @default(now())
  reversedAt       DateTime?
  reversedReason   String?
  reversedById     String?
  reversedBy       User?         @relation("VendorBillPaymentReversedBy", fields: [reversedById], references: [id])

  @@index([vendorBillId, paidAt])
  @@index([paidAt])
}

// =====================================================================
// PETTY CASH
// =====================================================================

model PettyCashFloat {
  id             String   @id @default(cuid())
  custodianId    String
  custodian      User     @relation(fields: [custodianId], references: [id])
  name           String // e.g. "Main kitchen float"
  openingBalance Decimal  @db.Decimal(14, 2)
  currentBalance Decimal  @default(0) @db.Decimal(14, 2)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  vouchers PettyCashVoucher[]
  topUps   PettyCashTopUp[]

  @@index([custodianId])
  @@index([active])
}

model PettyCashVoucher {
  id             String                 @id @default(cuid())
  voucherNo      String                 @unique // PCV-26-27-0001
  floatId        String
  float          PettyCashFloat         @relation(fields: [floatId], references: [id])
  amount         Decimal                @db.Decimal(14, 2)
  category       String // e.g. 'fuel' | 'subzi-mandi' | 'tea-coffee'
  paidTo         String
  reason         String
  paidAt         DateTime
  status         PettyCashVoucherStatus @default(DRAFT)
  approvedById   String?
  approvedBy     User?                  @relation("PettyCashVoucherApprovedBy", fields: [approvedById], references: [id])
  createdById    String
  createdBy      User                   @relation("PettyCashVoucherCreatedBy", fields: [createdById], references: [id])
  attachmentUrl  String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  reversedAt     DateTime?
  reversedReason String?

  @@index([floatId, paidAt])
  @@index([status])
}

model PettyCashTopUp {
  id               String         @id @default(cuid())
  floatId          String
  float            PettyCashFloat @relation(fields: [floatId], references: [id])
  amount           Decimal        @db.Decimal(14, 2)
  source           String // 'BANK_TRANSFER' | 'OWNER_CONTRIB' | 'OTHER'
  reference        String?
  approvedByUserId String?
  approvedBy       User?          @relation("PettyCashTopUpApprovedBy", fields: [approvedByUserId], references: [id])
  approvedAt       DateTime?
  createdAt        DateTime       @default(now())

  @@index([floatId, createdAt])
}

// =====================================================================
// SALARY
// =====================================================================

model SalaryStructure {
  id            String         @id @default(cuid())
  employeeId    String
  employee      User           @relation("SalaryStructureEmployee", fields: [employeeId], references: [id])
  type          EmploymentType
  hourlyRate    Decimal?       @db.Decimal(10, 2)
  monthlySalary Decimal?       @db.Decimal(12, 2)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  notes         String?
  createdAt     DateTime       @default(now())

  @@index([employeeId, effectiveFrom])
}

model SalaryRun {
  id           String          @id @default(cuid())
  runNo        String          @unique // SR-26-27-04 (FY + month)
  periodMonth  DateTime // first day of the month
  status       SalaryRunStatus @default(DRAFT)
  totalAmount  Decimal         @default(0) @db.Decimal(14, 2)
  createdById  String
  createdBy    User            @relation("SalaryRunCreatedBy", fields: [createdById], references: [id])
  approvedById String?
  approvedBy   User?           @relation("SalaryRunApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  postedAt     DateTime?
