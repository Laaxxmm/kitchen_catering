  appVersion String?
  lastSeen   DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
}

// =====================================================================
// AUDIT, DOCUMENTS, SETTINGS
// =====================================================================

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  action      String
  entity      String
  entityId    String
  payloadHash String?
  at          DateTime @default(now())

  @@index([entity, entityId])
  @@index([at])
}

model Document {
  id           String             @id @default(cuid())
  entityType   DocumentEntityType
  entityId     String // polymorphic — the FK to the entity, not enforced at DB level
  kind         DocumentKind       @default(ATTACHMENT)
  fileName     String
  fileSize     Int
  mimeType     String
  storagePath  String
  description  String?
  uploadedById String
  uploadedBy   User               @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  uploadedAt   DateTime           @default(now())

  @@index([entityType, entityId])
  @@index([uploadedAt])
}

// Runtime-editable settings. Keyed by `key`, value is JSON.
// Examples:
//   key: "po.approvalTiers" → {"auto": 100000, "manager": 1000000}
//   key: "recipe.defaultWastagePercent" → 5
//   key: "eInvoice.enabled" → true
//   key: "eInvoice.provider" → "CLEARTAX"
//   key: "branding.companyName" → "Indefine Kitchen Catering Co"
//   key: "delivery.otpProvider" → "MSG91"
model Settings {
  key       String   @id
  value     Json
  notes     String?
  updatedAt DateTime @updatedAt
}

